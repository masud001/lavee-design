{{ 'lavee-header-footer.css' | asset_url | stylesheet_tag }}

{% comment %}
  La Vee Ultimate Luxury Footer - Node ID: twkN3 / Section 16
  - Responsive Widths: Container Fluid (100% Full Width) vs Container (Max 1440px Centered)
  - Elements: Top Brand Headline, Reassurance Bar, Main Navigation, Newsletter Card, Acknowledgement, Bottom Utility Bar
  - Mobile Accordions for Navigation Columns with smooth animation & centered alignment
{% endcomment %}

<footer class="lavee-footer-wrapper" style="background-color: {{ section.settings.bg_color | default: '#F7F4EF' }};" role="contentinfo" aria-label="Site Footer">
  <div class="lavee-{{ section.settings.container_type }}">
    <div class="lavee-footer">
      
      <!-- Element 1: Top Brand Headline -->
      <div class="lavee-footer__headline">
        <h2 class="lavee-footer__headline-text">
          {{ section.settings.headline_text | default: "It's ALWAYS La Vee" }}
        </h2>
      </div>

      <div class="lavee-footer__divider" role="separator"></div>

      <!-- Element 2: Top Reassurance Bar (Desktop Row / Mobile Box Grid) -->
      <div class="lavee-footer__reassurance" role="region" aria-label="Customer Reassurance Benefits">
        <div class="lavee-footer__reassurance-item">
          <span class="lavee-footer__reassurance-title">RETURNS &amp; REFUNDS</span>
          <span class="lavee-footer__reassurance-sub lavee-desktop-only">Easy 30-day exchange policy</span>
          <span class="lavee-footer__reassurance-sub lavee-mobile-only">Easy 30-day exchange</span>
        </div>
        <div class="lavee-footer__reassurance-item">
          <span class="lavee-footer__reassurance-title">VIP LOYALTY BENEFITS</span>
          <span class="lavee-footer__reassurance-sub lavee-desktop-only">Earn points &amp; exclusive rewards</span>
          <span class="lavee-footer__reassurance-sub lavee-mobile-only">Earn points on orders</span>
        </div>
        <div class="lavee-footer__reassurance-item">
          <span class="lavee-footer__reassurance-title">BUY NOW PAY LATER</span>
          <span class="lavee-footer__reassurance-sub lavee-desktop-only">Klarna &amp; Afterpay available</span>
          <span class="lavee-footer__reassurance-sub lavee-mobile-only">Klarna &amp; Afterpay</span>
        </div>
        <div class="lavee-footer__reassurance-item">
          <span class="lavee-footer__reassurance-title">EXPRESS FAST DELIVERY</span>
          <span class="lavee-footer__reassurance-sub lavee-desktop-only">Tracked 2-4 day global shipping</span>
          <span class="lavee-footer__reassurance-sub lavee-mobile-only">Tracked 2-4 day shipping</span>
        </div>
      </div>

      <div class="lavee-footer__divider" role="separator"></div>

      <!-- Element 3 & 4: Main Footer Grid & Newsletter Box -->
      <div class="lavee-footer__grid">
        
        <!-- Left Navigation Columns (Desktop Grid / Mobile Accordions) -->
        <div class="lavee-footer__columns" role="navigation" aria-label="Footer Quick Links">
          
          <!-- Column 1: Need Help -->
          <div class="lavee-footer__col">
            <button 
              type="button" 
              id="FooterCol1Header"
              class="lavee-footer__accordion-btn" 
              aria-expanded="false" 
              aria-controls="FooterCol1Content"
            >
              <span class="lavee-footer__col-title">NEED SOME HELP?</span>
              <span class="lavee-footer__accordion-icon" aria-hidden="true">+</span>
            </button>
            <div id="FooterCol1Content" class="lavee-footer__col-content" aria-labelledby="FooterCol1Header">
              <ul class="lavee-footer__col-list">
                <li><a href="{{ routes.root_url }}pages/contact" class="lavee-footer__col-link">Contact Us</a></li>
                <li><a href="{{ routes.root_url }}pages/faqs" class="lavee-footer__col-link">FAQs &amp; Help Center</a></li>
                <li><a href="{{ routes.root_url }}pages/orders" class="lavee-footer__col-link">Orders &amp; Tracking</a></li>
                <li><a href="{{ routes.root_url }}pages/shipping" class="lavee-footer__col-link">Deliveries &amp; Shipping</a></li>
                <li><a href="{{ routes.root_url }}pages/returns" class="lavee-footer__col-link">Returns &amp; Exchanges</a></li>
                <li><a href="{{ routes.root_url }}pages/size-guide" class="lavee-footer__col-link">Size &amp; Fit Guide</a></li>
              </ul>
            </div>
          </div>

          <!-- Column 2: About La Vee -->
          <div class="lavee-footer__col">
            <button 
              type="button" 
              id="FooterCol2Header"
              class="lavee-footer__accordion-btn" 
              aria-expanded="false"
              aria-controls="FooterCol2Content"
            >
              <span class="lavee-footer__col-title">ABOUT LA VEE</span>
              <span class="lavee-footer__accordion-icon" aria-hidden="true">+</span>
            </button>
            <div id="FooterCol2Content" class="lavee-footer__col-content" aria-labelledby="FooterCol2Header">
              <ul class="lavee-footer__col-list">
                <li><a href="{{ routes.root_url }}pages/our-story" class="lavee-footer__col-link">House Of La Vee</a></li>
                <li><a href="{{ routes.root_url }}pages/sustainability" class="lavee-footer__col-link">Sustainability</a></li>
                <li><a href="{{ routes.root_url }}pages/fabrics" class="lavee-footer__col-link">Our Fabrics &amp; Tailoring</a></li>
                <li><a href="{{ routes.root_url }}pages/design" class="lavee-footer__col-link">Designed in Sydney</a></li>
                <li><a href="{{ routes.root_url }}pages/careers" class="lavee-footer__col-link">Careers</a></li>
              </ul>
            </div>
          </div>

          <!-- Column 3: Terms & Legals -->
          <div class="lavee-footer__col">
            <button 
              type="button" 
              id="FooterCol3Header"
              class="lavee-footer__accordion-btn" 
              aria-expanded="false"
              aria-controls="FooterCol3Content"
            >
              <span class="lavee-footer__col-title">TERMS &amp; LEGALS</span>
              <span class="lavee-footer__accordion-icon" aria-hidden="true">+</span>
            </button>
            <div id="FooterCol3Content" class="lavee-footer__col-content" aria-labelledby="FooterCol3Header">
              <ul class="lavee-footer__col-list">
                <li><a href="{{ routes.root_url }}policies/terms-of-service" class="lavee-footer__col-link">Terms &amp; Conditions</a></li>
                <li><a href="{{ routes.root_url }}policies/privacy-policy" class="lavee-footer__col-link">Privacy Policy</a></li>
                <li><a href="{{ routes.root_url }}pages/cookie-settings" class="lavee-footer__col-link">Cookie Preferences</a></li>
                <li><a href="{{ routes.root_url }}pages/accessibility" class="lavee-footer__col-link">Accessibility</a></li>
                <li><a href="{{ routes.account_url }}" class="lavee-footer__col-link">My Account &amp; Wishlist</a></li>
              </ul>
            </div>
          </div>

        </div>

        <!-- Right Newsletter & Social Box -->
        <div class="lavee-footer__newsletter-card" role="region" aria-label="Newsletter Subscription">
          <h3 class="lavee-footer__newsletter-title">StayCONNECTED</h3>
          <p class="lavee-footer__newsletter-desc">
            Sign up for exclusive access to new collection drops, secret VIP sales, and 10% off your first order.
          </p>
          
          {% form 'customer', class: 'lavee-footer__form' %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="lavee-footer__input-wrapper">
              <label for="LaveeFooterEmailInput" class="visually-hidden">Email address for newsletter subscription</label>
              <input 
                id="LaveeFooterEmailInput"
                type="email" 
                name="contact[email]" 
                class="lavee-footer__input" 
                placeholder="Enter your email address..."
                autocomplete="email"
                required
              >
              <button type="submit" class="lavee-footer__submit" aria-label="Subscribe to newsletter">SUBSCRIBE</button>
            </div>
          {% endform %}

          <!-- Social Media Row -->
          <div class="lavee-footer__social-row" role="navigation" aria-label="Social Media Links">
            <a href="https://tiktok.com" target="_blank" rel="noopener noreferrer" aria-label="Follow La Vee on TikTok (opens in a new tab)" class="lavee-footer__social-link">TIKTOK</a>
            <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" aria-label="Follow La Vee on Facebook (opens in a new tab)" class="lavee-footer__social-link">FACEBOOK</a>
            <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" aria-label="Follow La Vee on Instagram (opens in a new tab)" class="lavee-footer__social-link">INSTAGRAM</a>
            <a href="https://pinterest.com" target="_blank" rel="noopener noreferrer" aria-label="Follow La Vee on Pinterest (opens in a new tab)" class="lavee-footer__social-link">PINTEREST</a>
            <a href="https://youtube.com" target="_blank" rel="noopener noreferrer" aria-label="Subscribe to La Vee on YouTube (opens in a new tab)" class="lavee-footer__social-link lavee-desktop-only">YOUTUBE</a>
          </div>
        </div>

      </div>

      <!-- Element 5: Brand Acknowledgement Statement -->
      <div class="lavee-footer__acknowledgement">
        <p class="lavee-footer__acknowledgement-text">
          La Vee acknowledges the Traditional Custodians of the land on which we gather &amp; pay our respects to Elders past, present and emerging.
        </p>
      </div>

      <div class="lavee-footer__divider" role="separator"></div>

      <!-- Element 6: Bottom Utility Bar -->
      <div class="lavee-footer__bottom">
        <!-- Currency & Country Selector -->
        <div class="lavee-footer__currency-selector">
          <button type="button" class="lavee-footer__currency-btn" aria-label="Select Country and Currency (Currently set to United States USD)">
            United States (USD $) <span class="lavee-footer__currency-arrow" aria-hidden="true">▼</span>
          </button>
        </div>

        <!-- Payment Icons / Text List -->
        <div class="lavee-footer__payments">
          <span class="lavee-footer__payments-text">
            PAYPAL • AFTERPAY • APPLE PAY • KLARNA • VISA • MASTERCARD
          </span>
        </div>

        <!-- Brand Stamp Seal -->
        <div class="lavee-footer__brand-seal">
          <span class="lavee-footer__brand-seal-text">LAVEE DESIGN • EST. 2026</span>
        </div>

        <!-- Copyright Notice -->
        <div class="lavee-footer__copyright">
          <span>© 2026 La Vee Design Limited. All Rights Reserved.</span>
        </div>
      </div>

    </div>
  </div>
</footer>

<script>
  function initLaveeFooterAccordion() {
    const accordionBtns = document.querySelectorAll('.lavee-footer__accordion-btn');
    accordionBtns.forEach(btn => {
      btn.addEventListener('click', function() {
        const parent = this.closest('.lavee-footer__col');
        if (!parent) return;
        const content = parent.querySelector('.lavee-footer__col-content');
        const icon = this.querySelector('.lavee-footer__accordion-icon');
        const isExpanded = this.getAttribute('aria-expanded') === 'true';

        // Close all other accordions on mobile
        accordionBtns.forEach(otherBtn => {
          if (otherBtn !== this) {
            otherBtn.setAttribute('aria-expanded', 'false');
            const otherParent = otherBtn.closest('.lavee-footer__col');
            if (otherParent) {
              otherParent.classList.remove('is-open');
              const otherIcon = otherBtn.querySelector('.lavee-footer__accordion-icon');
              if (otherIcon) otherIcon.textContent = '+';
              const otherContent = otherParent.querySelector('.lavee-footer__col-content');
              if (otherContent) otherContent.style.maxHeight = null;
            }
          }
        });

        if (isExpanded) {
          this.setAttribute('aria-expanded', 'false');
          parent.classList.remove('is-open');
          if (icon) icon.textContent = '+';
          if (content) content.style.maxHeight = null;
        } else {
          this.setAttribute('aria-expanded', 'true');
          parent.classList.add('is-open');
          if (icon) icon.textContent = '-';
          if (content) content.style.maxHeight = content.scrollHeight + 'px';
        }
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initLaveeFooterAccordion);
  document.addEventListener('shopify:section:load', initLaveeFooterAccordion);
</script>

{% schema %}
{
  "name": "La Vee Luxury Footer",
  "settings": [
    {
      "type": "header",
      "content": "Layout Width"
    },
    {
      "type": "select",
      "id": "container_type",
      "label": "Section Width Type",
      "options": [
        { "value": "container-fluid", "label": "Container Fluid (Full Width - 100%)" },
        { "value": "container", "label": "Container (Fixed Width / Centered)" }
      ],
      "default": "container-fluid"
    },
    {
      "type": "header",
      "content": "Content & Branding"
    },
    {
      "type": "text",
      "id": "headline_text",
      "label": "Top Brand Headline",
      "default": "It's ALWAYS La Vee"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F7F4EF"
    }
  ],
  "presets": [
    {
      "name": "La Vee Luxury Footer"
    }
  ]
}
{% endschema %}

