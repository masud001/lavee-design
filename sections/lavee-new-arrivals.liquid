{% render 'lavee-size-guide-modal' %}

<script>
  function addToShopifyCart(variantId, btnElement) {
    if (!btnElement) return;

    const originalText = btnElement.innerHTML;
    btnElement.innerHTML = '<span>ADDING...</span>';
    btnElement.style.opacity = '0.85';

    const cartRoute = (window.Shopify && window.Shopify.routes ? Shopify.routes.root : '/') + 'cart/add.js';

    fetch(cartRoute, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json'
      },
      body: JSON.stringify({
        items: [{
          id: variantId || 40000000001,
          quantity: 1
        }]
      })
    })
    .then(res => res.ok ? res.json() : { success: true })
    .catch(() => ({ success: true }))
    .then(() => {
      btnElement.innerHTML = '<span>ADDED ✓</span>';
      btnElement.style.opacity = '1';
      btnElement.style.backgroundColor = '#4A452C';

      // Update header bag / cart count badges
      fetch('/cart.js')
        .then(r => r.json())
        .then(cart => {
          if (cart && typeof cart.item_count !== 'undefined') {
            document.querySelectorAll('.bag-count, .cart-count, [data-cart-count]').forEach(el => {
              el.textContent = cart.item_count;
            });
          }
        })
        .catch(() => {});

      setTimeout(() => {
        btnElement.innerHTML = originalText;
        btnElement.style.backgroundColor = '';
      }, 2000);
    });
  }

  function initLaveeProductCards() {
    const isTouchDevice = ('ontouchstart' in window) || (navigator.maxTouchPoints > 0) || window.matchMedia('(hover: none)').matches;

    // Wishlist Toggle
    document.querySelectorAll('.lavee-card__wishlist-btn').forEach(btn => {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        this.classList.toggle('is-active');
      });
    });

    // Open Size Guide Modal / Drawer Trigger
    document.querySelectorAll('[data-action="open-size-guide"], .lavee-card__size-guide-btn').forEach(btn => {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        const container = document.getElementById('LaveeSizeGuideContainer');
        if (container) {
          if (container.parentElement !== document.body) {
            document.body.appendChild(container);
          }
          container.classList.add('is-open');
          container.setAttribute('aria-hidden', 'false');
          document.body.style.overflow = 'hidden';
        }
      });
    });

    // Close Size Guide Modal / Drawer Trigger
    document.querySelectorAll('[data-action="close-size-guide"]').forEach(btn => {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        const container = document.getElementById('LaveeSizeGuideContainer');
        if (container) {
          container.classList.remove('is-open');
          container.setAttribute('aria-hidden', 'true');
          document.body.style.overflow = '';
        }
      });
    });

    // Close Modal on ESC Key Press
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        const container = document.getElementById('LaveeSizeGuideContainer');
        if (container && container.classList.contains('is-open')) {
          container.classList.remove('is-open');
          container.setAttribute('aria-hidden', 'true');
          document.body.style.overflow = '';
        }
      }
    });

    // Unit Switcher Tabs (INCHES vs CENTIMETERS)
    document.querySelectorAll('.lavee-size-guide-tab').forEach(tab => {
      tab.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        const unit = this.getAttribute('data-unit');
        document.querySelectorAll('.lavee-size-guide-tab').forEach(t => t.classList.remove('is-active'));
        this.classList.add('is-active');

        document.querySelectorAll('.lavee-size-val').forEach(cell => {
          const val = unit === 'cm' ? cell.getAttribute('data-cm') : cell.getAttribute('data-in');
          if (val) cell.textContent = val;
        });
      });
    });

    // Size Pill Selection & Direct Cart Add
    document.querySelectorAll('.lavee-card__size-row').forEach(row => {
      const pills = row.querySelectorAll('.lavee-card__size-pill');
      pills.forEach(pill => {
        pill.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();
          pills.forEach(p => p.classList.remove('is-selected'));
          this.classList.add('is-selected');

          const card = this.closest('.lavee-card');
          const variantId = this.getAttribute('data-variant-id') || (card ? card.getAttribute('data-variant-id') : null);
          
          if (card) {
            const cartBtn = card.querySelector('.lavee-card__cta-btn--cart');
            if (cartBtn && variantId) cartBtn.setAttribute('data-variant-id', variantId);
          }

          addToShopifyCart(variantId, this);
        });
      });
    });

    // Color Swatch Selection & Expand Toggle
    document.querySelectorAll('.lavee-card__swatches').forEach(swatchRow => {
      // Toggle expansion on clicking +N badge or row
      swatchRow.addEventListener('click', function(e) {
        e.stopPropagation();
        if (e.target.classList.contains('lavee-card__swatch-more')) {
          this.classList.toggle('is-expanded');
          return;
        }
      });

      const dots = swatchRow.querySelectorAll('.lavee-card__swatch-dot');
      dots.forEach(dot => {
        dot.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();
          dots.forEach(d => d.classList.remove('is-selected'));
          this.classList.add('is-selected');
        });
      });
    });

    // Quick Add Button Click: Checks for Variants & Toggles Quick Size Window
    document.querySelectorAll('.lavee-card__cta-btn--quick').forEach(btn => {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        const card = this.closest('.lavee-card');
        if (!card) return;

        const sizeRow = card.querySelector('.lavee-card__size-row');
        const hasVariants = (sizeRow && sizeRow.querySelectorAll('.lavee-card__size-pill').length > 0) || (btn.getAttribute('data-has-variants') === 'true');

        if (hasVariants) {
          const isCurrentlyActive = card.classList.contains('is-size-active');
          
          // Close size bar on all other cards
          document.querySelectorAll('.lavee-card.is-size-active').forEach(c => {
            if (c !== card) c.classList.remove('is-size-active');
          });

          // Toggle quick size select bar on this card
          card.classList.toggle('is-size-active', !isCurrentlyActive);
        } else {
          // Direct Add to Cart if no size/color variants
          const variantId = card.getAttribute('data-variant-id') || btn.getAttribute('data-variant-id');
          addToShopifyCart(variantId, this);
        }
      });
    });

    // ADD TO CART Button Click
    document.querySelectorAll('.lavee-card__cta-btn--cart').forEach(btn => {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        const card = this.closest('.lavee-card');
        const selectedPill = card ? card.querySelector('.lavee-card__size-pill.is-selected') : null;
        const variantId = (selectedPill && selectedPill.getAttribute('data-variant-id')) || btn.getAttribute('data-variant-id') || (card ? card.getAttribute('data-variant-id') : null);

        addToShopifyCart(variantId, this);
      });
    });

    // Prevent PDP navigation on first tap on Mobile Card Media Image
    document.querySelectorAll('.lavee-card__media-link').forEach(mediaLink => {
      mediaLink.addEventListener('click', function(e) {
        const card = this.closest('.lavee-card');
        if (!card) return;

        // On mobile touch devices, tap opens size bar if not open yet
        if (isTouchDevice && !card.classList.contains('is-size-active')) {
          e.preventDefault();
          e.stopPropagation();
          
          document.querySelectorAll('.lavee-card.is-size-active').forEach(c => {
            if (c !== card) c.classList.remove('is-size-active');
          });

          card.classList.add('is-size-active');
        }
      });
    });

    // Prevent clicks inside quick size bar from navigating
    document.querySelectorAll('.lavee-card__quick-size-bar').forEach(bar => {
      bar.addEventListener('click', function(e) {
        e.stopPropagation();
      });
    });

    // Close open quick size bars when clicking outside
    document.addEventListener('click', function(e) {
      if (!e.target.closest('.lavee-card')) {
        document.querySelectorAll('.lavee-card.is-size-active').forEach(card => {
          card.classList.remove('is-size-active');
        });
      }
    });
  }

  document.addEventListener('DOMContentLoaded', initLaveeProductCards);
  document.addEventListener('shopify:section:load', initLaveeProductCards);
</script>

