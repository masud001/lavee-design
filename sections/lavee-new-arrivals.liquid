{{ 'section-lavee-new-arrivals.css' | asset_url | stylesheet_tag }}

{% comment %}
  La Vee Atelier Luxury Product Card & New Arrivals Grid Section - Node ID: Component/ProductCard
  - Swatches & Star Rating on Same Top Row (Swatches Left, Star Rating Right)
  - Full-Width Title Row (Title Only for Maximum Readability)
  - Atelier Stylish Inner Border Frame with Wishlist Heart Toggle
  - On-Hover Quick Size Select Bar (XS, S, M, L, XL) with Size Guide Link
  - Dual Action CTA Row (+ QUICK ADD & ADD TO CART)
  - Hybrid Architecture: Shopify Collection & Custom Product Blocks
{% endcomment %}

{%- assign color_scheme = section.settings.color_scheme | default: 'ivory' -%}
{%- assign size_guide_url = section.settings.size_guide_url | default: routes.root_url | append: 'pages/size-guide' -%}

<div class="lavee-new-arrivals-section lavee-new-arrivals-section--{{ color_scheme }}" role="region" aria-label="{{ section.settings.title | escape }}">
  <div class="lavee-{{ section.settings.container_type | default: 'container-fluid' }}">
    <div class="lavee-new-arrivals-container">
      
      <!-- Section Header Box -->
      {%- if section.settings.title != blank or section.settings.subtitle != blank or section.settings.view_all_label != blank -%}
        <div class="lavee-new-arrivals-header" data-pencil-name="Section Header">
          <div class="lavee-new-arrivals-title-box" data-pencil-name="Title Box">
            {%- if section.settings.title != blank -%}
              <h2 class="lavee-new-arrivals-title">
                {{ section.settings.title | escape }}
              </h2>
            {%- endif -%}

            {%- if section.settings.subtitle != blank -%}
              <p class="lavee-new-arrivals-subtitle">
                {{ section.settings.subtitle | escape }}
              </p>
            {%- endif -%}
          </div>

          {%- if section.settings.view_all_label != blank -%}
            {%- assign view_all_url = section.settings.view_all_link | default: routes.all_products_collection_url -%}
            <a href="{{ view_all_url }}" class="lavee-new-arrivals-view-all" aria-label="{{ section.settings.view_all_label | escape }}">
              <span>{{ section.settings.view_all_label | escape }}</span>
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

      <!-- Product Cards Grid -->
      <div class="lavee-new-arrivals-grid" data-pencil-name="Product Cards Grid">
        
        {%- assign selected_collection = section.settings.collection -%}
        {%- assign products_limit = section.settings.products_to_show | default: 4 -%}

        {%- if selected_collection != blank -%}
          <!-- Render Shopify Collection Products -->
          {%- if selected_collection.products.size > 0 -%}
            {%- for product in selected_collection.products limit: products_limit -%}
              {% render 'lavee-product-card', product: product, size_guide_url: size_guide_url, show_secondary_image: section.settings.show_secondary_image %}
            {%- endfor -%}
          {%- else -%}
            <!-- Empty Collection Onboarding State -->
            {%- for i in (1..products_limit) -%}
              {% render 'lavee-product-card', size_guide_url: size_guide_url %}
            {%- endfor -%}
          {%- endif -%}

        {%- elsif section.blocks.size > 0 -%}
          <!-- Render Custom Manual Product Blocks or Single Picked Products -->
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'product' -%}
                {%- if block.settings.product != blank -%}
                  {% render 'lavee-product-card', product: block.settings.product, size_guide_url: size_guide_url, show_secondary_image: section.settings.show_secondary_image %}
                {%- else -%}
                  {% render 'lavee-product-card', block: block, size_guide_url: size_guide_url %}
                {%- endif -%}
              {%- when 'product_card' -%}
                {% render 'lavee-product-card', block: block, size_guide_url: size_guide_url %}
            {%- endcase -%}
          {%- endfor -%}

        {%- else -%}
          <!-- Default Fallback Product Cards (Exact Atelier Specs) when no collection or blocks exist -->
          
          <!-- Card 1 -->
          <div class="lavee-card" data-pencil-name="Component/ProductCard" data-product-id="dummy-1" data-variant-id="40000000001">
            <div class="lavee-card__media" data-pencil-name="Product Image Container">
              <div class="lavee-card__image-wrap">
                <a href="{{ routes.all_products_collection_url }}" class="lavee-card__media-link" aria-label="Aura Corset Satin Midi">
                  <img 
                    src="https://images.unsplash.com/photo-1708434034707-0580ada65d8d?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&w=800" 
                    alt="Aura Corset Satin Midi" 
                    width="400" 
                    height="567" 
                    loading="lazy" 
                    class="lavee-card__image"
                  >
                </a>
              </div>

              <div class="lavee-card__inner-frame" data-pencil-name="Atelier Stylish Inner Border Frame">
                <div class="lavee-card__top-overlay" data-pencil-name="Top Overlay Row">
                  <div class="lavee-card__badge-pill-box" data-pencil-name="Badge Pill Box">
                    <span class="lavee-card__badge-pill" data-pencil-name="Badge Text">NEW ARRIVAL</span>
                  </div>
                  <button type="button" class="lavee-card__wishlist-btn" data-pencil-name="Wishlist Heart Box" aria-label="Add to Wishlist">
                    <span data-pencil-name="Heart Icon">♥</span>
                  </button>
                </div>

                <div class="lavee-card__quick-size-bar" data-pencil-name="On-Hover Quick Size Bar">
                  <div class="lavee-card__size-header" data-pencil-name="Hover Header">
                    <span class="lavee-card__size-title" data-pencil-name="Size Select Title">
                      <span class="lavee-card__size-title-full">QUICK SIZE SELECT:</span>
                      <span class="lavee-card__size-title-short">SIZE SELECT:</span>
                    </span>
                    <button type="button" class="lavee-card__size-guide-link lavee-card__size-guide-btn" data-action="open-size-guide" data-pencil-name="Size Guide Link">Size Guide 📏</button>
                  </div>
                  <div class="lavee-card__size-row" data-pencil-name="Size Variant Pills Row">
                    <button type="button" class="lavee-card__size-pill" data-variant-id="40000000001" data-pencil-name="Size - XXS">XXS</button>
                    <button type="button" class="lavee-card__size-pill" data-variant-id="40000000002" data-pencil-name="Size - XS">XS</button>
                    <button type="button" class="lavee-card__size-pill is-selected" data-variant-id="40000000003" data-pencil-name="Size - S">S</button>
                    <button type="button" class="lavee-card__size-pill" data-variant-id="40000000004" data-pencil-name="Size - M">M</button>
                    <button type="button" class="lavee-card__size-pill" data-variant-id="40000000005" data-pencil-name="Size - L">L</button>
                    <button type="button" class="lavee-card__size-pill" data-variant-id="40000000006" data-pencil-name="Size - XL">XL</button>
                    <button type="button" class="lavee-card__size-pill" data-variant-id="40000000007" data-pencil-name="Size - XXL">XXL</button>
                    <button type="button" class="lavee-card__size-pill" data-variant-id="40000000008" data-pencil-name="Size - 3XL">3XL</button>
