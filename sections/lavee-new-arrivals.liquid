                  <span class="lavee-card__swatch-dot lavee-card__swatch-dot--extra" style="background-color: #6E1F2A;" data-pencil-name="Swatch Dot 4" title="Deep Burgundy"></span>
                  <span class="lavee-card__swatch-dot lavee-card__swatch-dot--extra" style="background-color: #E6D8C3;" data-pencil-name="Swatch Dot 5" title="Champagne"></span>
