{{ 'section-lavee-shop-by-category.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  La Vee Shop by Category Section - Advanced Edition
  - Header Content: ALWAYS inside centered container
  - Track Container: Fluid 100% or Centered Container
  - Independent Arrow Positioning per Breakpoint: top_right, bottom_right, bottom_left, bottom_center, center_sides
  - Independent Arrow Show/Hide per Breakpoint: Desktop/Tablet vs Mobile
{%- endcomment -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    padding-left: {{ section.settings.padding_left_right_mobile }}px;
    padding-right: {{ section.settings.padding_left_right_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      padding-left: {{ section.settings.padding_left_right_desktop }}px;
      padding-right: {{ section.settings.padding_left_right_desktop }}px;
    }
  }

  #shopify-section-{{ section.id }} {
    --lavee-cat-card-height-mobile: {{ section.settings.card_height_mobile }}px;
    --lavee-cat-card-height-desktop: {{ section.settings.card_height_desktop }}px;
    --lavee-cat-border-color: {{ section.settings.card_border_color | default: '#D8D2CA' }};
    --lavee-cat-border-width: {{ section.settings.card_border_width | default: 0 }}px;
    --lavee-cat-inner-border-color: {{ section.settings.inner_border_color | default: 'rgba(255, 255, 255, 0.7)' }};
    --lavee-cat-inner-border-width: {{ section.settings.inner_border_width | default: 0.5 }}px;
    --lavee-cat-card-radius: {{ section.settings.card_corner_radius | default: 0 }}px;
    --lavee-cat-inner-radius: {{ section.settings.inner_corner_radius | default: 0 }}px;
    --lavee-cat-pill-radius: {{ section.settings.pill_corner_radius | default: 0 }}px;
    --lavee-cat-pill-border-width: {{ section.settings.pill_border_width | default: 1 }}px;
    --lavee-cat-pill-border-color: {{ section.settings.pill_border_color | default: 'rgba(255, 255, 255, 0.45)' }};
    --lavee-cat-pill-padding-v: {{ section.settings.pill_padding_v | default: 14 }}px;
    --lavee-cat-pill-padding-h: {{ section.settings.pill_padding_h | default: 20 }}px;
    
    --lavee-cat-grid-gap-desktop: {{ section.settings.grid_gap_desktop | default: 0 }}px;
    --lavee-cat-grid-gap-tablet: {{ section.settings.grid_gap_tablet | default: 0 }}px;
    --lavee-cat-grid-gap-mobile: {{ section.settings.grid_gap_mobile | default: 0 }}px;

    --lavee-cat-cols-desktop: {{ section.settings.items_to_show_desktop | default: 4 }};
    --lavee-cat-cols-tablet: {{ section.settings.items_to_show_tablet | default: 2 }};
    --lavee-cat-cols-mobile: {{ section.settings.items_to_show_mobile | default: '1.5' }};

    --lavee-cat-card-outer-padding: {{ section.settings.card_outer_padding | default: 0 }}px;
    --lavee-cat-card-inner-padding: {{ section.settings.card_inner_padding | default: 20 }}px;

    --lavee-cat-header-gap: {{ section.settings.header_gap | default: 10 }}px;
    --lavee-cat-header-mb: {{ section.settings.header_margin_bottom | default: 40 }}px;
  }

  /* Header Dynamic Typography */
  #shopify-section-{{ section.id }} .lavee-category-eyebrow {
    font-size: {{ section.settings.eyebrow_font_size_mobile }}px;
    {% if section.settings.eyebrow_color != blank %}color: {{ section.settings.eyebrow_color }};{% endif %}
  }
  #shopify-section-{{ section.id }} .lavee-category-title {
    font-size: {{ section.settings.title_font_size_mobile }}px;
    font-weight: {{ section.settings.title_font_weight | default: 500 }};
    {% if section.settings.title_color != blank %}color: {{ section.settings.title_color }};{% endif %}
  }
  #shopify-section-{{ section.id }} .lavee-category-subtext {
    font-size: {{ section.settings.subtext_font_size_mobile }}px;
    {% if section.settings.subtext_color != blank %}color: {{ section.settings.subtext_color }};{% endif %}
  }

  /* Tablet Responsive Typography Optimization */
  @media screen and (min-width: 750px) and (max-width: 989px) {
    #shopify-section-{{ section.id }} .lavee-category-eyebrow {
      font-size: clamp({{ section.settings.eyebrow_font_size_mobile }}px, 1.5vw, {{ section.settings.eyebrow_font_size_desktop }}px);
    }
    #shopify-section-{{ section.id }} .lavee-category-title {
      font-size: clamp({{ section.settings.title_font_size_mobile }}px, 3.8vw, {{ section.settings.title_font_size_desktop }}px);
    }
    #shopify-section-{{ section.id }} .lavee-category-subtext {
      font-size: clamp({{ section.settings.subtext_font_size_mobile }}px, 2vw, {{ section.settings.subtext_font_size_desktop }}px);
    }
  }

  /* Desktop Typography */
  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .lavee-category-eyebrow {
      font-size: {{ section.settings.eyebrow_font_size_desktop }}px;
    }
    #shopify-section-{{ section.id }} .lavee-category-title {
      font-size: {{ section.settings.title_font_size_desktop }}px;
    }
    #shopify-section-{{ section.id }} .lavee-category-subtext {
      font-size: {{ section.settings.subtext_font_size_desktop }}px;
    }
  }
{%- endstyle -%}

<div class="lavee-category-section lavee-category-section--{{ section.settings.color_scheme | default: 'ivory' }} section-{{ section.id }}-padding
  lavee-arrows-desktop-{{ section.settings.show_arrows_desktop }}
  lavee-arrows-mobile-{{ section.settings.show_arrows_mobile }}
  lavee-arrows-pos-desktop-{{ section.settings.arrows_position_desktop | default: 'center_sides' }}
  lavee-arrows-pos-mobile-{{ section.settings.arrows_position_mobile | default: 'center_sides' }}
  lavee-layout-desktop-{{ section.settings.layout_desktop | default: 'grid' }}
  lavee-layout-tablet-{{ section.settings.layout_tablet | default: 'grid' }}
  lavee-layout-mobile-{{ section.settings.layout_mobile | default: 'slider' }}"
  id="LaveeCategorySection-{{ section.id }}"
>
  
  {%- comment -%}
    1. Header Content & Typography ALWAYS inside Centered Container
  {%- endcomment -%}
  <div class="lavee-container">
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank or section.settings.subtext != blank or section.settings.show_arrows_desktop or section.settings.show_arrows_mobile -%}
      <header class="lavee-category-header lavee-category-header--{{ section.settings.heading_alignment | default: 'left' }}">
        <div class="lavee-category-header-content">
          {%- if section.settings.eyebrow != blank -%}
            <span class="lavee-category-eyebrow">{{ section.settings.eyebrow | escape }}</span>
          {%- endif -%}

          {%- if section.settings.heading != blank -%}
            <h2 class="lavee-category-title">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}

          {%- if section.settings.subtext != blank -%}
            <p class="lavee-category-subtext">{{ section.settings.subtext | escape }}</p>
          {%- endif -%}
        </div>

        {%- comment -%} Top Right Header Aligned Arrows {%- endcomment -%}
        <div class="lavee-category-top-arrows">
          <button type="button" class="lavee-slider-arrow lavee-slider-arrow--prev" aria-label="Previous categories">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
          </button>
          <button type="button" class="lavee-slider-arrow lavee-slider-arrow--next" aria-label="Next categories">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
          </button>
        </div>
      </header>
    {%- endif -%}
  </div>

  {%- comment -%}
    2. Category Track Container (Fluid 100% or Centered Container)
  {%- endcomment -%}
  <div class="lavee-{{ section.settings.container_type | default: 'container-fluid' }}">
    <div 
      class="lavee-category-wrapper 
        lavee-category-layout-desktop-{{ section.settings.layout_desktop | default: 'grid' }}
        lavee-category-layout-tablet-{{ section.settings.layout_tablet | default: 'grid' }}
        lavee-category-layout-mobile-{{ section.settings.layout_mobile | default: 'slider' }}
        lavee-category-cols-mobile-{{ section.settings.items_to_show_mobile | replace: '.', '-' | default: '1-5' }}"
      data-lavee-slider="{{ section.settings.layout_desktop }}"
      data-lavee-slider-mobile="{{ section.settings.layout_mobile }}"
      data-autoplay="{{ section.settings.slider_autoplay }}"
      data-speed="{{ section.settings.slider_autoplay_speed | default: 5 }}"
      data-initial-limit="{{ section.settings.grid_items_limit | default: 4 }}"
      data-step-desktop="{{ section.settings.items_to_show_desktop | default: 4 }}"
      data-step-tablet="{{ section.settings.items_to_show_tablet | default: 2 }}"
      data-step-mobile="{{ section.settings.items_to_show_mobile | default: 2 }}"
    >
      {%- comment -%} Side Center Overlay Arrows {%- endcomment -%}
      <div class="lavee-category-side-arrows">
        <button type="button" class="lavee-slider-arrow lavee-slider-arrow--prev" aria-label="Previous categories">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <button type="button" class="lavee-slider-arrow lavee-slider-arrow--next" aria-label="Next categories">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
        </button>
      </div>

      <div class="lavee-category-track" data-pencil-name="Category Grid">
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            {%- liquid
              assign collection_obj = block.settings.collection
              assign category_title = block.settings.title | default: collection_obj.title | default: "CATEGORY"
              assign category_url = block.settings.link | default: collection_obj.url | default: "/collections/all"
              assign category_image = block.settings.image | default: collection_obj.featured_image
              assign custom_img_url = block.settings.image_url
              assign media_type = block.settings.media_type | default: "image"
              assign video_shopify = block.settings.video_shopify
              assign video_url = block.settings.video_url
              assign button_label = block.settings.button_text
              
              assign piece_count = block.settings.subtitle
              if piece_count == blank and section.settings.show_product_count != false
                if collection_obj != blank
                  assign count_val = collection_obj.all_products_count | default: collection_obj.products_count
                  if count_val != blank
                    case section.settings.count_format
                      when 'items'
                        assign piece_count = count_val | append: " ITEMS"
                      when 'products'
                        assign piece_count = count_val | append: " PRODUCTS"
                      when 'number_only'
                        assign piece_count = count_val
                      else
                        assign piece_count = count_val | append: " PIECES"
                    endcase
                  endif
                else
                  # Automatic Fallback Product Count for Placeholder / Custom items without collection
                  assign default_num = forloop.index | times: 6 | plus: 10
                  case section.settings.count_format
                    when 'items'
                      assign piece_count = default_num | append: " ITEMS"
                    when 'products'
                      assign piece_count = default_num | append: " PRODUCTS"
                    when 'number_only'
                      assign piece_count = default_num
                    else
                      assign piece_count = default_num | append: " PIECES"
                  endcase
                endif
              endif
            -%}

            <div class="lavee-category-card-wrapper{% if section.settings.grid_button_action == 'load_more' and forloop.index > section.settings.grid_items_limit %} lavee-grid-item-hidden{% endif %}" {{ block.shopify_attributes }}>
              <a href="{{ category_url }}" class="lavee-category-card" aria-label="{{ category_title | escape }}">
                <div class="lavee-category-image-wrap">
                  {%- if media_type == 'video' or video_shopify != blank or video_url != blank -%}
                    {%- if video_shopify != blank -%}
                      {{ video_shopify | video_tag: 
                        autoplay: true, 
                        loop: true, 
                        muted: true, 
                        controls: false, 
                        playsinline: true,
                        class: 'lavee-category-video'
                      }}
                    {%- elsif video_url != blank -%}
                      <video class="lavee-category-video" autoplay loop muted playsinline>
                        <source src="{{ video_url }}" type="video/mp4">
                      </video>
                    {%- elsif category_image != blank -%}
                      {{ category_image | image_url: width: 800 | image_tag: loading: 'lazy', decoding: 'async', class: 'lavee-category-img', alt: category_title }}
                    {%- elsif custom_img_url != blank -%}
                      <img src="{{ custom_img_url }}" alt="{{ category_title | escape }}" class="lavee-category-img" loading="lazy" decoding="async">
                    {%- else -%}
                      <img src="https://images.unsplash.com/photo-1708434034707-0580ada65d8d?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&w=1080" alt="{{ category_title }}" class="lavee-category-img" loading="lazy">
                    {%- endif -%}
                  {%- else -%}
                    {%- if category_image != blank -%}
                      {{ category_image | image_url: width: 800 | image_tag: 
                        loading: 'lazy',
                        decoding: 'async',
                        widths: '300, 450, 600, 800',
                        sizes: '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 80vw',
                        class: 'lavee-category-img',
                        alt: category_title
                      }}
                    {%- elsif custom_img_url != blank -%}
                      <img src="{{ custom_img_url }}" alt="{{ category_title | escape }}" width="800" height="1000" class="lavee-category-img" loading="lazy" decoding="async">
                    {%- else -%}
                      {%- comment -%} Default Luxury Unsplash Fallbacks {%- endcomment -%}
                      {%- case forloop.index -%}
                        {%- when 1 -%}
                          <img src="https://images.unsplash.com/photo-1708434034707-0580ada65d8d?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&w=1080" alt="Dresses" width="800" height="1000" class="lavee-category-img" loading="lazy" decoding="async">
                        {%- when 2 -%}
                          <img src="https://images.unsplash.com/photo-1773574488217-eb936b733cae?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&w=1080" alt="Sets" width="800" height="1000" class="lavee-category-img" loading="lazy" decoding="async">
                        {%- when 3 -%}
                          <img src="https://images.unsplash.com/photo-1710090411838-5f846e289b2e?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&w=1080" alt="Tops & Corsets" width="800" height="1000" class="lavee-category-img" loading="lazy" decoding="async">
                        {%- when 4 -%}
                          <img src="https://images.unsplash.com/photo-1593530097577-bbf5f393ad7a?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&w=1080" alt="Occasionwear" width="800" height="1000" class="lavee-category-img" loading="lazy" decoding="async">
                        {%- else -%}
                          <div class="lavee-category-placeholder lavee-category-placeholder--bg-{{ forloop.index }}">
                            {{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'lavee-category-placeholder-svg' }}
                          </div>
                      {%- endcase -%}
                    {%- endif -%}
                  {%- endif -%}
                  <div class="lavee-category-overlay" aria-hidden="true"></div>
                </div>

                {%- if section.settings.show_inner_border -%}
                  <div class="lavee-category-inner-frame">
                {%- endif -%}

                <div class="lavee-category-content">
                  <div class="lavee-category-label-pill" style="{% if block.settings.button_bg_override != blank %}background: {{ block.settings.button_bg_override }};{% endif %}">
                    {%- if piece_count != blank and section.settings.show_product_count != false -%}
                      <span class="lavee-category-count-badge">{{ piece_count | escape }}</span>
                    {%- endif -%}

                    <h3 class="lavee-category-card-title" style="{% if block.settings.title_color_override != blank %}color: {{ block.settings.title_color_override }};{% endif %}" data-split="true">
                      {%- assign char_index = 0 -%}
                      {%- assign title_words = category_title | split: ' ' -%}
                      {%- for word in title_words -%}
                        <span class="lavee-title-word">
                          {%- assign word_chars = word | split: '' -%}
                          {%- for char in word_chars -%}
                            <span class="lavee-char" style="--char-index: {{ char_index }}">{{ char }}</span>
                            {%- assign char_index = char_index | plus: 1 -%}
                          {%- endfor -%}
                        </span>
                        {%- unless forloop.last -%}&nbsp;{%- endunless -%}
                      {%- endfor -%}
                    </h3>

                    {%- if button_label != blank and block.settings.show_button != false -%}
                      <span class="lavee-category-btn" style="{% if block.settings.button_color_override != blank %}color: {{ block.settings.button_color_override }};{% endif %}">
                        {{ button_label | escape }}
                      </span>
                    {%- endif -%}
                  </div>
                </div>

                {%- if section.settings.show_inner_border -%}
                  </div>
                {%- endif -%}
              </a>
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- comment -%} Default 8 Luxury Categories for Slider Preview {%- endcomment -%}
          {%- assign default_titles = "Dresses,Matching Sets,Tops & Corsets,Occasionwear,Gowns & Atelier,Tailored Suits,Skirts & Bottoms,Couture Accessories" | split: "," -%}
          {%- assign default_buttons = "Shop Dresses →,Shop Sets →,Shop Tops →,Shop Occasion →,Shop Gowns →,Shop Suits →,Shop Skirts →,Shop Accessories →" | split: "," -%}
          {%- assign default_imgs = "https://images.unsplash.com/photo-1708434034707-0580ada65d8d?w=1080,https://images.unsplash.com/photo-1773574488217-eb936b733cae?w=1080,https://images.unsplash.com/photo-1710090411838-5f846e289b2e?w=1080,https://images.unsplash.com/photo-1593530097577-bbf5f393ad7a?w=1080,https://images.unsplash.com/photo-1566174053879-31528523f8ae?w=1080,https://images.unsplash.com/photo-1539109136881-3be0616acf4b?w=1080,https://images.unsplash.com/photo-1583496661160-fb5886a0aaaa?w=1080,https://images.unsplash.com/photo-1509631179647-0177331693ae?w=1080" | split: "," -%}
          {%- assign default_counts = "24 PIECES,18 PIECES,14 PIECES,32 PIECES,20 PIECES,16 PIECES,22 PIECES,15 PIECES" | split: "," -%}
          
          {%- for cat_title in default_titles -%}
            {%- assign idx = forloop.index0 -%}
            {%- assign default_count_num = default_counts[idx] -%}
            {%- if section.settings.count_format == 'items' -%}
              {%- assign default_count_num = default_count_num | replace: 'PIECES', 'ITEMS' -%}
            {%- elsif section.settings.count_format == 'products' -%}
              {%- assign default_count_num = default_count_num | replace: 'PIECES', 'PRODUCTS' -%}
            {%- elsif section.settings.count_format == 'number_only' -%}
              {%- assign default_count_num = default_count_num | replace: ' PIECES', '' -%}
            {%- endif -%}

            <div class="lavee-category-card-wrapper{% if section.settings.grid_button_action == 'load_more' and forloop.index > section.settings.grid_items_limit %} lavee-grid-item-hidden{% endif %}">
              <a href="/collections/all" class="lavee-category-card" aria-label="{{ cat_title }}">
                <div class="lavee-category-image-wrap">
                  <img src="{{ default_imgs[idx] }}" alt="{{ cat_title }}" width="800" height="1000" class="lavee-category-img" loading="lazy" decoding="async">
                  <div class="lavee-category-overlay" aria-hidden="true"></div>
                </div>

                {%- if section.settings.show_inner_border -%}
                  <div class="lavee-category-inner-frame">
                {%- endif -%}

                <div class="lavee-category-content">
                  <div class="lavee-category-label-pill">
                    {%- if section.settings.show_product_count != false -%}
                      <span class="lavee-category-count-badge">{{ default_count_num }}</span>
                    {%- endif -%}
                    <h3 class="lavee-category-card-title" data-split="true">
                      {%- assign char_index = 0 -%}
                      {%- assign title_words = cat_title | split: ' ' -%}
                      {%- for word in title_words -%}
                        <span class="lavee-title-word">
                          {%- assign word_chars = word | split: '' -%}
                          {%- for char in word_chars -%}
                            <span class="lavee-char" style="--char-index: {{ char_index }}">{{ char }}</span>
                            {%- assign char_index = char_index | plus: 1 -%}
                          {%- endfor -%}
                        </span>
                        {%- unless forloop.last -%}&nbsp;{%- endunless -%}
                      {%- endfor -%}
                    </h3>
                    <span class="lavee-category-btn">{{ default_buttons[idx] }}</span>
                  </div>
                </div>

                {%- if section.settings.show_inner_border -%}
                  </div>
                {%- endif -%}
              </a>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>

      {%- comment -%} Bottom Arrows Container {%- endcomment -%}
      <div class="lavee-category-bottom-arrows">
        <button type="button" class="lavee-slider-arrow lavee-slider-arrow--prev" aria-label="Previous categories">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <button type="button" class="lavee-slider-arrow lavee-slider-arrow--next" aria-label="Next categories">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
        </button>
      </div>

      {%- if section.settings.show_slider_dots -%}
        <div class="lavee-slider-pagination" aria-hidden="true"></div>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%}
    3. Grid Footer Action Button (Load More or View All Link) inside Container
  {%- endcomment -%}
  {%- if section.settings.grid_button_action != 'none' -%}
    <div class="lavee-container">
      <div class="lavee-category-grid-footer 
        lavee-grid-footer-desktop-{{ section.settings.layout_desktop | default: 'grid' }}
        lavee-grid-footer-tablet-{{ section.settings.layout_tablet | default: 'grid' }}
        lavee-grid-footer-mobile-{{ section.settings.layout_mobile | default: 'slider' }}"
      >
        {%- if section.settings.grid_button_action == 'load_more' -%}
          <button 
            type="button" 
            class="lavee-btn lavee-grid-load-more-btn lavee-btn--{{ section.settings.grid_button_style | default: 'outline' }}"
            data-text-more="{{ section.settings.grid_button_text | default: 'EXPLORE ALL CATEGORIES' | escape }}"
            data-text-less="SHOW LESS"
          >
            <span>{{ section.settings.grid_button_text | default: 'EXPLORE ALL CATEGORIES' | escape }}</span>
            <svg class="lavee-btn-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </button>
        {%- elsif section.settings.grid_button_action == 'link' -%}
          <a 
            href="{{ section.settings.grid_button_link | default: '/collections' }}" 
