{{ 'section-lavee-shop-by-category.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  La Vee Shop by Category Section - Advanced Edition
  - Responsive Layouts: Grid or Slider independently per breakpoint (Desktop, Tablet, Mobile)
  - Full Media Support: Image (Picker / URL) and Video (Shopify Video / MP4 URL)
  - Custom Container Width & Padding: Full Width (Fluid) vs Centered (Container), Left/Right Padding controls
  - Complete Header Typography & Alignment: Title, Subtitle, Description with sizes, colors, and gap settings
  - Full WCAG 2.1 AAA accessibility & SEO support
{%- endcomment -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    padding-left: {{ section.settings.padding_left_right_mobile }}px;
    padding-right: {{ section.settings.padding_left_right_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      padding-left: {{ section.settings.padding_left_right_desktop }}px;
      padding-right: {{ section.settings.padding_left_right_desktop }}px;
    }
  }

  #shopify-section-{{ section.id }} {
    --lavee-cat-card-height-mobile: {{ section.settings.card_height_mobile }}px;
    --lavee-cat-card-height-desktop: {{ section.settings.card_height_desktop }}px;
    --lavee-cat-border-color: {{ section.settings.card_border_color | default: '#D8D2CA' }};
    --lavee-cat-border-width: {{ section.settings.card_border_width | default: 1 }}px;
    --lavee-cat-inner-border-color: {{ section.settings.inner_border_color | default: 'rgba(255, 255, 255, 0.7)' }};
    --lavee-cat-card-radius: {{ section.settings.card_corner_radius | default: 8 }}px;
    --lavee-cat-inner-radius: {{ section.settings.inner_corner_radius | default: 4 }}px;
    --lavee-cat-pill-radius: {{ section.settings.pill_corner_radius | default: 4 }}px;
    
    --lavee-cat-grid-gap-desktop: {{ section.settings.grid_gap_desktop | default: 24 }}px;
    --lavee-cat-grid-gap-tablet: {{ section.settings.grid_gap_tablet | default: 20 }}px;
    --lavee-cat-grid-gap-mobile: {{ section.settings.grid_gap_mobile | default: 16 }}px;

    --lavee-cat-cols-desktop: {{ section.settings.items_to_show_desktop | default: 4 }};
    --lavee-cat-cols-tablet: {{ section.settings.items_to_show_tablet | default: 2 }};
    --lavee-cat-cols-mobile: {{ section.settings.items_to_show_mobile | default: 2 }};

    --lavee-cat-card-outer-padding: {{ section.settings.card_outer_padding | default: 8 }}px;
    --lavee-cat-card-inner-padding: {{ section.settings.card_inner_padding | default: 20 }}px;

    --lavee-cat-header-gap: {{ section.settings.header_gap | default: 10 }}px;
    --lavee-cat-header-mb: {{ section.settings.header_margin_bottom | default: 40 }}px;
  }

  /* Header Dynamic Typography */
  #shopify-section-{{ section.id }} .lavee-category-eyebrow {
    font-size: {{ section.settings.eyebrow_font_size_mobile }}px;
    {% if section.settings.eyebrow_color != blank %}color: {{ section.settings.eyebrow_color }};{% endif %}
  }
  #shopify-section-{{ section.id }} .lavee-category-title {
    font-size: {{ section.settings.title_font_size_mobile }}px;
    font-weight: {{ section.settings.title_font_weight | default: 500 }};
    {% if section.settings.title_color != blank %}color: {{ section.settings.title_color }};{% endif %}
  }
  #shopify-section-{{ section.id }} .lavee-category-subtext {
    font-size: {{ section.settings.subtext_font_size_mobile }}px;
    {% if section.settings.subtext_color != blank %}color: {{ section.settings.subtext_color }};{% endif %}
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .lavee-category-eyebrow {
      font-size: {{ section.settings.eyebrow_font_size_desktop }}px;
    }
    #shopify-section-{{ section.id }} .lavee-category-title {
      font-size: {{ section.settings.title_font_size_desktop }}px;
    }
    #shopify-section-{{ section.id }} .lavee-category-subtext {
      font-size: {{ section.settings.subtext_font_size_desktop }}px;
    }
  }
{%- endstyle -%}

<div class="lavee-category-section lavee-category-section--{{ section.settings.color_scheme | default: 'ivory' }} section-{{ section.id }}-padding">
  <div class="lavee-{{ section.settings.container_type | default: 'container' }}">
    
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank or section.settings.subtext != blank or section.settings.show_slider_arrows -%}
      <header class="lavee-category-header lavee-category-header--{{ section.settings.heading_alignment | default: 'left' }}">
        <div class="lavee-category-header-content">
          {%- if section.settings.eyebrow != blank -%}
            <span class="lavee-category-eyebrow">{{ section.settings.eyebrow | escape }}</span>
          {%- endif -%}

          {%- if section.settings.heading != blank -%}
            <h2 class="lavee-category-title">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}

          {%- if section.settings.subtext != blank -%}
            <p class="lavee-category-subtext">{{ section.settings.subtext | escape }}</p>
          {%- endif -%}
        </div>

        {%- if section.settings.show_slider_arrows -%}
          <div class="lavee-category-top-arrows">
            <button type="button" class="lavee-slider-arrow lavee-slider-arrow--prev" aria-label="Previous categories">
              ‹
            </button>
            <button type="button" class="lavee-slider-arrow lavee-slider-arrow--next" aria-label="Next categories">
              ›
            </button>
          </div>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- comment -%}
      Main Container: Grid vs Slider Mode
    {%- endcomment -%}
    <div 
      class="lavee-category-wrapper 
        lavee-category-layout-desktop-{{ section.settings.layout_desktop | default: 'grid' }}
        lavee-category-layout-tablet-{{ section.settings.layout_tablet | default: 'grid' }}
        lavee-category-layout-mobile-{{ section.settings.layout_mobile | default: 'grid' }}
        lavee-category-cols-mobile-{{ section.settings.items_to_show_mobile | replace: '.', '-' | default: '1-5' }}"
      data-lavee-slider="{{ section.settings.layout_desktop }}"
      data-lavee-slider-mobile="{{ section.settings.layout_mobile }}"
      data-autoplay="{{ section.settings.slider_autoplay }}"
      data-speed="{{ section.settings.slider_autoplay_speed | default: 5 }}"
    >
      <div class="lavee-category-track" data-pencil-name="Category Grid">
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            {%- liquid
              assign collection_obj = block.settings.collection
              assign category_title = block.settings.title | default: collection_obj.title | default: "CATEGORY"
              assign category_url = block.settings.link | default: collection_obj.url | default: "/collections/all"
              assign category_image = block.settings.image | default: collection_obj.featured_image
              assign custom_img_url = block.settings.image_url
              assign media_type = block.settings.media_type | default: "image"
              assign video_shopify = block.settings.video_shopify
              assign video_url = block.settings.video_url
              assign button_label = block.settings.button_text
              assign piece_count = block.settings.subtitle
            -%}

            <div class="lavee-category-card-wrapper" {{ block.shopify_attributes }}>
              <a href="{{ category_url }}" class="lavee-category-card" aria-label="{{ category_title | escape }}">
                <div class="lavee-category-image-wrap">
                  {%- if media_type == 'video' -%}
                    {%- if video_shopify != blank -%}
                      {{ video_shopify | video_tag: 
                        autoplay: true, 
                        loop: true, 
                        muted: true, 
                        controls: false, 
                        playsinline: true,
                        class: 'lavee-category-video'
                      }}
                    {%- elsif video_url != blank -%}
                      <video class="lavee-category-video" autoplay loop muted playsinline>
                        <source src="{{ video_url }}" type="video/mp4">
                      </video>
                    {%- elsif category_image != blank -%}
                      {{ category_image | image_url: width: 800 | image_tag: loading: 'lazy', decoding: 'async', class: 'lavee-category-img', alt: category_title }}
                    {%- else -%}
                      <img src="https://images.unsplash.com/photo-1708434034707-0580ada65d8d?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&w=1080" alt="{{ category_title }}" class="lavee-category-img" loading="lazy">
                    {%- endif -%}
                  {%- else -%}
                    {%- if category_image != blank -%}
                      {{ category_image | image_url: width: 800 | image_tag: 
                        loading: 'lazy',
                        decoding: 'async',
                        class: 'lavee-category-img',
                        alt: category_title
                      }}
                    {%- elsif custom_img_url != blank -%}
                      <img src="{{ custom_img_url }}" alt="{{ category_title | escape }}" class="lavee-category-img" loading="lazy" decoding="async">
                    {%- else -%}
                      {%- comment -%} Default Luxury Unsplash Fallbacks {%- endcomment -%}
                      {%- case forloop.index -%}
                        {%- when 1 -%}
                          <img src="https://images.unsplash.com/photo-1708434034707-0580ada65d8d?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&w=1080" alt="Dresses" class="lavee-category-img" loading="lazy">
                        {%- when 2 -%}
                          <img src="https://images.unsplash.com/photo-1773574488217-eb936b733cae?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&w=1080" alt="Sets" class="lavee-category-img" loading="lazy">
                        {%- when 3 -%}
                          <img src="https://images.unsplash.com/photo-1710090411838-5f846e289b2e?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&w=1080" alt="Tops & Corsets" class="lavee-category-img" loading="lazy">
                        {%- when 4 -%}
                          <img src="https://images.unsplash.com/photo-1593530097577-bbf5f393ad7a?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&w=1080" alt="Occasionwear" class="lavee-category-img" loading="lazy">
                        {%- else -%}
                          <div class="lavee-category-placeholder lavee-category-placeholder--bg-{{ forloop.index }}">
                            {{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'lavee-category-placeholder-svg' }}
                          </div>
                      {%- endcase -%}
                    {%- endif -%}
                  {%- endif -%}
                  <div class="lavee-category-overlay" aria-hidden="true"></div>
                </div>

                {%- if section.settings.show_inner_border -%}
                  <div class="lavee-category-inner-frame">
                {%- endif -%}

                <div class="lavee-category-content">
                  <div class="lavee-category-label-pill" style="{% if block.settings.button_bg_override != blank %}background: {{ block.settings.button_bg_override }};{% endif %}">
                    {%- if piece_count != blank -%}
                      <span class="lavee-category-count-badge">{{ piece_count | escape }}</span>
                    {%- endif -%}

                    <h3 class="lavee-category-card-title" style="{% if block.settings.title_color_override != blank %}color: {{ block.settings.title_color_override }};{% endif %}">
                      {{ category_title | escape }}
                    </h3>

                    {%- if button_label != blank and block.settings.show_button != false -%}
                      <span class="lavee-category-btn" style="{% if block.settings.button_color_override != blank %}color: {{ block.settings.button_color_override }};{% endif %}">
                        {{ button_label | escape }}
                      </span>
                    {%- endif -%}
                  </div>
                </div>

                {%- if section.settings.show_inner_border -%}
                  </div>
                {%- endif -%}
              </a>
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- comment -%} Default 8 Luxury Categories for Slider Preview {%- endcomment -%}
          {%- assign default_titles = "DRESSES,MATCHING SETS,TOPS & CORSETS,OCCASIONWEAR,GOWNS & ATELIER,TAILORED SUITS,SKIRTS & BOTTOMS,COUTURE ACCESSORIES" | split: "," -%}
          {%- assign default_buttons = "Shop Dresses →,Shop Sets →,Shop Tops →,Shop Occasion →,Shop Gowns →,Shop Suits →,Shop Skirts →,Shop Accessories →" | split: "," -%}
          {%- assign default_imgs = "https://images.unsplash.com/photo-1708434034707-0580ada65d8d?w=1080,https://images.unsplash.com/photo-1773574488217-eb936b733cae?w=1080,https://images.unsplash.com/photo-1710090411838-5f846e289b2e?w=1080,https://images.unsplash.com/photo-1593530097577-bbf5f393ad7a?w=1080,https://images.unsplash.com/photo-1566174053879-31528523f8ae?w=1080,https://images.unsplash.com/photo-1539109136881-3be0616acf4b?w=1080,https://images.unsplash.com/photo-1583496661160-fb5886a0aaaa?w=1080,https://images.unsplash.com/photo-1509631179647-0177331693ae?w=1080" | split: "," -%}
          
          {%- for cat_title in default_titles -%}
            {%- assign idx = forloop.index0 -%}
            <div class="lavee-category-card-wrapper">
              <a href="/collections/all" class="lavee-category-card" aria-label="{{ cat_title }}">
                <div class="lavee-category-image-wrap">
                  <img src="{{ default_imgs[idx] }}" alt="{{ cat_title }}" class="lavee-category-img" loading="lazy">
                  <div class="lavee-category-overlay" aria-hidden="true"></div>
                </div>

                {%- if section.settings.show_inner_border -%}
                  <div class="lavee-category-inner-frame">
                {%- endif -%}

                <div class="lavee-category-content">
                  <div class="lavee-category-label-pill">
                    <h3 class="lavee-category-card-title">{{ cat_title }}</h3>
                    <span class="lavee-category-btn">{{ default_buttons[idx] }}</span>
                  </div>
                </div>

                {%- if section.settings.show_inner_border -%}
                  </div>
                {%- endif -%}
              </a>
            </div>
          {%- endfor -%}
        {%- endif -%}
      {%- if section.settings.show_slider_dots -%}
        <div class="lavee-slider-pagination" aria-hidden="true"></div>
      {%- endif -%}
    </div>

  </div>
</div>

<script>
  (function() {
    function initCategorySliders() {
      const sectionWrappers = document.querySelectorAll('.lavee-category-wrapper');
      sectionWrappers.forEach(wrapper => {
        const track = wrapper.querySelector('.lavee-category-track');
        const prevBtn = wrapper.querySelector('.lavee-slider-arrow--prev');
        const nextBtn = wrapper.querySelector('.lavee-slider-arrow--next');
        const pagination = wrapper.querySelector('.lavee-slider-pagination');
        if (!track) return;

        const isDesktopSlider = wrapper.getAttribute('data-lavee-slider') === 'slider';
        const isMobileSlider = wrapper.getAttribute('data-lavee-slider-mobile') === 'slider';
        const isAutoplay = wrapper.getAttribute('data-autoplay') === 'true';
        const speed = parseInt(wrapper.getAttribute('data-speed') || '5', 10) * 1000;

        function scrollNext() {
          const cardWidth = track.firstElementChild ? track.firstElementChild.getBoundingClientRect().width : 300;
          track.scrollBy({ left: cardWidth + 24, behavior: 'smooth' });
        }

        function scrollPrev() {
          const cardWidth = track.firstElementChild ? track.firstElementChild.getBoundingClientRect().width : 300;
          track.scrollBy({ left: -(cardWidth + 24), behavior: 'smooth' });
        }

        if (prevBtn) prevBtn.addEventListener('click', scrollPrev);
        if (nextBtn) nextBtn.addEventListener('click', scrollNext);

        let autoplayTimer = null;
        if (isAutoplay) {
          autoplayTimer = setInterval(() => {
            if (track.scrollLeft + track.clientWidth >= track.scrollWidth - 10) {
              track.scrollTo({ left: 0, behavior: 'smooth' });
            } else {
              scrollNext();
            }
          }, speed);

          wrapper.addEventListener('mouseenter', () => clearInterval(autoplayTimer));
          wrapper.addEventListener('mouseleave', () => {
            autoplayTimer = setInterval(scrollNext, speed);
          });
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCategorySliders);
    } else {
      initCategorySliders();
    }
  })();
</script>

{% schema %}
{
  "name": "La Vee Shop by Category",
  "tag": "section",
  "class": "lavee-shop-by-category-section",
  "settings": [
    {
      "type": "header",
      "content": "Section Layout & Container Width"
    },
    {
      "type": "select",
      "id": "container_type",
      "label": "Container Width Type",
      "options": [
        { "value": "container-fluid", "label": "Full Width (100% Fullscreen Fluid)" },
        { "value": "container", "label": "Centered Container (Max 1440px)" }
      ],
      "default": "container-fluid"
    },
    {
      "type": "range",
      "id": "padding_left_right_desktop",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Section Left/Right Padding (Desktop)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_left_right_mobile",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Section Left/Right Padding (Mobile)",
      "default": 0
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Background Color Scheme",
      "options": [
        { "value": "ivory", "label": "Ivory (#F7F4EF)" },
        { "value": "dark", "label": "Dark Luxe (#161616)" },
        { "value": "burgundy", "label": "Burgundy (#6E1F2A)" }
      ],
      "default": "ivory"
    },
    {
      "type": "header",
      "content": "Layout Mode (Grid vs Slider)"
    },
    {
      "type": "select",
      "id": "layout_desktop",
      "label": "Desktop Layout Mode",
      "options": [
        { "value": "grid", "label": "CSS Grid" },
        { "value": "slider", "label": "Carousel / Slider" }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "layout_tablet",
      "label": "Tablet Layout Mode",
      "options": [
        { "value": "grid", "label": "CSS Grid" },
        { "value": "slider", "label": "Carousel / Slider" }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "layout_mobile",
      "label": "Mobile Layout Mode",
      "options": [
        { "value": "grid", "label": "CSS Grid" },
        { "value": "slider", "label": "Carousel / Slider" }
      ],
      "default": "slider"
    },
    {
      "type": "header",
      "content": "Slider Settings (Active in Slider Mode)"
    },
    {
      "type": "checkbox",
      "id": "show_slider_arrows",
      "label": "Show Slider Prev/Next Arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_slider_dots",
      "label": "Show Slider Pagination Dots",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "slider_autoplay",
      "label": "Enable Slider Autoplay",
      "default": false
    },
    {
      "type": "range",
      "id": "slider_autoplay_speed",
      "min": 3,
      "max": 12,
      "step": 1,
      "unit": "s",
      "label": "Autoplay Duration",
      "default": 5
    },
    {
      "type": "header",
      "content": "Items Display & Spacing Controls"
    },
    {
      "type": "range",
      "id": "items_to_show_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Items to Show (Desktop)",
      "default": 4
    },
    {
      "type": "range",
      "id": "items_to_show_tablet",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Items to Show (Tablet)",
      "default": 2
    },
    {
      "type": "select",
      "id": "items_to_show_mobile",
      "label": "Items to Show (Mobile)",
      "options": [
        { "value": "1", "label": "1 Item (Full Width)" },
        { "value": "1.5", "label": "1.5 Items (1 Full + Half Peek)" },
        { "value": "2", "label": "2 Items" }
      ],
      "default": "1.5"
    },
    {
      "type": "range",
      "id": "grid_gap_desktop",
      "min": 0,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Spacing Between Items (Desktop)",
      "default": 0
    },
    {
      "type": "range",
      "id": "grid_gap_tablet",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Spacing Between Items (Tablet)",
      "default": 0
    },
    {
      "type": "range",
      "id": "grid_gap_mobile",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
