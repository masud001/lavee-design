<script>
  (function() {
    function initStaggerTitles() {
      const titles = document.querySelectorAll('.lavee-category-card-title');
      titles.forEach(titleEl => {
        if (titleEl.getAttribute('data-split') === 'true') return;
        const text = titleEl.textContent.trim();
        if (!text) return;

        titleEl.innerHTML = '';
        titleEl.setAttribute('data-split', 'true');
        let charIdx = 0;

        const words = text.split(/\s+/);
        words.forEach((word, wIdx) => {
          const wordSpan = document.createElement('span');
          wordSpan.className = 'lavee-title-word';

          Array.from(word).forEach(ch => {
            const charSpan = document.createElement('span');
            charSpan.className = 'lavee-char';
            charSpan.style.setProperty('--char-index', charIdx);
            charSpan.textContent = ch;
            wordSpan.appendChild(charSpan);
            charIdx++;
          });

          titleEl.appendChild(wordSpan);
          if (wIdx < words.length - 1) {
            const space = document.createTextNode(' ');
            titleEl.appendChild(space);
          }
        });
      });

      const cards = document.querySelectorAll('.lavee-category-card');
      cards.forEach(card => {
        if (card.getAttribute('data-hover-init') === 'true') return;
        card.setAttribute('data-hover-init', 'true');

        card.addEventListener('mouseenter', function() {
          const chars = card.querySelectorAll('.lavee-char');
          chars.forEach((c) => {
            c.style.animation = 'none';
            void c.offsetWidth;
            const idx = parseFloat(c.style.getPropertyValue('--char-index')) || 0;
            c.style.animation = `laveeStaggerChar 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275) ${idx * 0.03}s forwards`;
          });
        });
      });
    }

    function initCategorySliders() {
      initStaggerTitles();
      const sections = document.querySelectorAll('.lavee-category-section');
      sections.forEach(section => {
        const wrapper = section.querySelector('.lavee-category-wrapper');
        const track = section.querySelector('.lavee-category-track');
        if (!track || !wrapper) return;

        const isAutoplay = wrapper.getAttribute('data-autoplay') === 'true';
        const speed = parseInt(wrapper.getAttribute('data-speed') || '5', 10) * 1000;

        function scrollNext() {
          const cardWidth = track.firstElementChild ? track.firstElementChild.getBoundingClientRect().width : 300;
          track.scrollBy({ left: cardWidth + 24, behavior: 'smooth' });
        }

        function scrollPrev() {
          const cardWidth = track.firstElementChild ? track.firstElementChild.getBoundingClientRect().width : 300;
          track.scrollBy({ left: -(cardWidth + 24), behavior: 'smooth' });
        }

        section.querySelectorAll('.lavee-slider-arrow--prev').forEach(btn => {
          btn.addEventListener('click', scrollPrev);
        });

        section.querySelectorAll('.lavee-slider-arrow--next').forEach(btn => {
          btn.addEventListener('click', scrollNext);
        });

        const loadMoreBtn = section.querySelector('.lavee-grid-load-more-btn');
        if (loadMoreBtn) {
          loadMoreBtn.addEventListener('click', function() {
            const span = loadMoreBtn.querySelector('span');
            const textMore = loadMoreBtn.getAttribute('data-text-more') || 'EXPLORE ALL CATEGORIES';
            const textLess = loadMoreBtn.getAttribute('data-text-less') || 'SHOW LESS';

            const initialLimit = parseInt(wrapper.getAttribute('data-initial-limit') || '4', 10);
            const stepDesktop = parseInt(wrapper.getAttribute('data-step-desktop') || '4', 10);
            const stepTablet = parseInt(wrapper.getAttribute('data-step-tablet') || '2', 10);
            const stepMobileVal = parseFloat(wrapper.getAttribute('data-step-mobile') || '2');
            const stepMobile = Math.max(1, Math.floor(stepMobileVal));

            // Determine active breakpoint step for batch loading
            const w = window.innerWidth;
            let currentStep = stepDesktop;
            if (w < 750) {
              currentStep = stepMobile;
            } else if (w < 990) {
              currentStep = stepTablet;
            }

            const allCardWrappers = track.querySelectorAll('.lavee-category-card-wrapper');
            const hiddenItems = Array.from(track.querySelectorAll('.lavee-grid-item-hidden'));

            if (hiddenItems.length === 0 && loadMoreBtn.classList.contains('is-active')) {
              // Collapse back to initial limit
              allCardWrappers.forEach((item, idx) => {
                if (idx >= initialLimit) {
                  item.classList.add('lavee-grid-item-hidden');
                  item.classList.remove('lavee-item-revealed');
                }
              });
              track.classList.remove('is-expanded');
              if (span) span.textContent = textMore;
              loadMoreBtn.classList.remove('is-active');

              const header = section.querySelector('.lavee-category-header');
              if (header) {
                header.scrollIntoView({ behavior: 'smooth', block: 'start' });
              }
            } else {
              // Reveal next batch equal to active device step count
              const itemsToReveal = hiddenItems.slice(0, currentStep);
              itemsToReveal.forEach(item => {
                item.classList.remove('lavee-grid-item-hidden');
                item.classList.add('lavee-item-revealed');
              });

              // Re-run stagger title split for newly revealed items
              initStaggerTitles();

              const remainingHidden = track.querySelectorAll('.lavee-grid-item-hidden').length;
              if (remainingHidden === 0) {
                track.classList.add('is-expanded');
                if (span) span.textContent = textLess;
                loadMoreBtn.classList.add('is-active');
              } else {
                if (span) span.textContent = textMore;
                loadMoreBtn.classList.remove('is-active');
              }
            }
          });
        }

        let autoplayTimer = null;
        if (isAutoplay) {
          autoplayTimer = setInterval(() => {
            if (track.scrollLeft + track.clientWidth >= track.scrollWidth - 10) {
              track.scrollTo({ left: 0, behavior: 'smooth' });
            } else {
              scrollNext();
            }
          }, speed);

          wrapper.addEventListener('mouseenter', () => clearInterval(autoplayTimer));
          wrapper.addEventListener('mouseleave', () => {
            autoplayTimer = setInterval(scrollNext, speed);
          });
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCategorySliders);
    } else {
      initCategorySliders();
    }
  })();
</script>

