{{ 'section-lavee-shop-by-category.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  La Vee Shop by Category Section
  - Responsive Width: Container Fluid vs Container
  - Color Schemes: Ivory (#F7F4EF), Dark (#161616), Burgundy (#6E1F2A)
  - Customizer Settings: Image Picker, Image URL, Outer Border, Inner Luxury Border, Corner Radius, Spacing
  - Hover Animations: Luxury image zoom & content elevate
  - Full WCAG 2.1 AAA accessibility & SEO support
{%- endcomment -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #shopify-section-{{ section.id }} {
    --lavee-cat-card-height-mobile: {{ section.settings.card_height_mobile }}px;
    --lavee-cat-card-height-desktop: {{ section.settings.card_height_desktop }}px;
    --lavee-cat-border-color: {{ section.settings.card_border_color | default: '#D8D2CA' }};
    --lavee-cat-border-width: {{ section.settings.card_border_width | default: 1 }}px;
    --lavee-cat-inner-border-color: {{ section.settings.inner_border_color | default: 'rgba(255, 255, 255, 0.7)' }};
    --lavee-cat-card-radius: {{ section.settings.card_corner_radius | default: 8 }}px;
    --lavee-cat-inner-radius: {{ section.settings.inner_corner_radius | default: 4 }}px;
    --lavee-cat-pill-radius: {{ section.settings.pill_corner_radius | default: 4 }}px;
    --lavee-cat-grid-gap-desktop: {{ section.settings.grid_gap_desktop | default: 24 }}px;
    --lavee-cat-grid-gap-mobile: {{ section.settings.grid_gap_mobile | default: 16 }}px;
    --lavee-cat-card-outer-padding: {{ section.settings.card_outer_padding | default: 8 }}px;
    --lavee-cat-card-inner-padding: {{ section.settings.card_inner_padding | default: 20 }}px;
  }
{%- endstyle -%}

<div class="lavee-category-section lavee-category-section--{{ section.settings.color_scheme | default: 'ivory' }} section-{{ section.id }}-padding">
  <div class="lavee-{{ section.settings.container_type | default: 'container' }}">
    
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank or section.settings.subtext != blank -%}
      <header class="lavee-category-header lavee-category-header--{{ section.settings.heading_alignment | default: 'left' }}">
        {%- if section.settings.eyebrow != blank -%}
          <span class="lavee-category-eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="lavee-category-title">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        {%- if section.settings.subtext != blank -%}
          <p class="lavee-category-subtext">{{ section.settings.subtext | escape }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    <div 
      class="lavee-category-grid lavee-category-grid--desktop-{{ section.settings.columns_desktop | default: 4 }} lavee-category-grid--mobile-{{ section.settings.columns_mobile | default: 2 }}"
      data-pencil-name="Category Grid"
    >
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign collection_obj = block.settings.collection
            assign category_title = block.settings.title | default: collection_obj.title | default: "CATEGORY"
            assign category_url = block.settings.link | default: collection_obj.url | default: "/collections/all"
            assign category_image = block.settings.image | default: collection_obj.featured_image
            assign custom_img_url = block.settings.image_url
            assign button_label = block.settings.button_text
          -%}

          <div class="lavee-category-card-wrapper" {{ block.shopify_attributes }}>
            <a href="{{ category_url }}" class="lavee-category-card" aria-label="{{ category_title | escape }}">
              <div class="lavee-category-image-wrap">
                {%- if category_image != blank -%}
                  {{ category_image | image_url: width: 800 | image_tag: 
                    loading: 'lazy',
                    decoding: 'async',
                    class: 'lavee-category-img',
                    alt: category_title
                  }}
                {%- elsif custom_img_url != blank -%}
                  <img src="{{ custom_img_url }}" alt="{{ category_title | escape }}" class="lavee-category-img" loading="lazy" decoding="async">
                {%- else -%}
                  {%- comment -%} Default Luxury Unsplash Fallbacks {%- endcomment -%}
                  {%- case forloop.index -%}
                    {%- when 1 -%}
                      <img src="https://images.unsplash.com/photo-1708434034707-0580ada65d8d?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&w=1080" alt="Dresses" class="lavee-category-img" loading="lazy">
                    {%- when 2 -%}
                      <img src="https://images.unsplash.com/photo-1773574488217-eb936b733cae?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&w=1080" alt="Sets" class="lavee-category-img" loading="lazy">
                    {%- when 3 -%}
                      <img src="https://images.unsplash.com/photo-1710090411838-5f846e289b2e?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&w=1080" alt="Tops & Corsets" class="lavee-category-img" loading="lazy">
                    {%- when 4 -%}
                      <img src="https://images.unsplash.com/photo-1593530097577-bbf5f393ad7a?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&w=1080" alt="Occasionwear" class="lavee-category-img" loading="lazy">
                    {%- else -%}
                      <div class="lavee-category-placeholder lavee-category-placeholder--bg-{{ forloop.index }}">
                        {{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'lavee-category-placeholder-svg' }}
                      </div>
                  {%- endcase -%}
                {%- endif -%}
                <div class="lavee-category-overlay" aria-hidden="true"></div>
              </div>

              {%- if section.settings.show_inner_border -%}
                <div class="lavee-category-inner-frame">
              {%- endif -%}

              <div class="lavee-category-content">
                <div class="lavee-category-label-pill">
                  <h3 class="lavee-category-card-title">{{ category_title | escape }}</h3>

                  {%- if button_label != blank -%}
                    <span class="lavee-category-btn">
                      {{ button_label | escape }}
                    </span>
                  {%- endif -%}
                </div>
              </div>

              {%- if section.settings.show_inner_border -%}
                </div>
              {%- endif -%}
            </a>
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} Default 4 Luxury Categories from Pencil Spec {%- endcomment -%}
        {%- assign default_titles = "DRESSES,MATCHING SETS,TOPS & CORSETS,OCCASIONWEAR" | split: "," -%}
        {%- assign default_buttons = "Shop Dresses →,Shop Sets →,Shop Tops →,Shop Occasion →" | split: "," -%}
        {%- assign default_imgs = "https://images.unsplash.com/photo-1708434034707-0580ada65d8d?w=1080,https://images.unsplash.com/photo-1773574488217-eb936b733cae?w=1080,https://images.unsplash.com/photo-1710090411838-5f846e289b2e?w=1080,https://images.unsplash.com/photo-1593530097577-bbf5f393ad7a?w=1080" | split: "," -%}
        
        {%- for cat_title in default_titles -%}
          {%- assign idx = forloop.index0 -%}
          <div class="lavee-category-card-wrapper">
            <a href="/collections/all" class="lavee-category-card" aria-label="{{ cat_title }}">
              <div class="lavee-category-image-wrap">
                <img src="{{ default_imgs[idx] }}" alt="{{ cat_title }}" class="lavee-category-img" loading="lazy">
                <div class="lavee-category-overlay" aria-hidden="true"></div>
              </div>

              {%- if section.settings.show_inner_border -%}
                <div class="lavee-category-inner-frame">
              {%- endif -%}

              <div class="lavee-category-content">
                <div class="lavee-category-label-pill">
                  <h3 class="lavee-category-card-title">{{ cat_title }}</h3>
                  <span class="lavee-category-btn">{{ default_buttons[idx] }}</span>
                </div>
              </div>

              {%- if section.settings.show_inner_border -%}
                </div>
              {%- endif -%}
            </a>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "La Vee Shop by Category",
  "tag": "section",
  "class": "lavee-shop-by-category-section",
  "settings": [
    {
      "type": "header",
      "content": "Header & Text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "SHOP BY CATEGORY"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Subtitle"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Section Description"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading Alignment",
      "options": [
        { "value": "left", "label": "Left Aligned" },
        { "value": "center", "label": "Centered" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Layout & Container Width"
    },
    {
      "type": "select",
      "id": "container_type",
      "label": "Container Width",
      "options": [
        { "value": "container-fluid", "label": "Full Width (100% Fluid)" },
        { "value": "container", "label": "Centered Container (Max 1440px)" }
      ],
      "default": "container"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Background Color Scheme",
      "options": [
        { "value": "ivory", "label": "Ivory (#F7F4EF)" },
        { "value": "dark", "label": "Dark Luxe (#161616)" },
        { "value": "burgundy", "label": "Burgundy (#6E1F2A)" }
      ],
      "default": "ivory"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Desktop Columns",
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Mobile Columns",
      "options": [
        { "value": "1", "label": "1 Column" },
        { "value": "2", "label": "2 Columns" }
      ],
      "default": "2"
    },
    {
      "type": "header",
      "content": "Card Borders & Framing"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card Outer Border Color",
      "default": "#D8D2CA"
    },
    {
      "type": "range",
      "id": "card_border_width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "label": "Card Outer Border Width",
      "default": 1
    },
    {
      "type": "checkbox",
      "id": "show_inner_border",
      "label": "Enable Atelier Luxury Inner Border Frame",
      "default": true
    },
    {
      "type": "color",
      "id": "inner_border_color",
      "label": "Inner Frame Border Color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Card Corner Radii (Rounded Corners)"
    },
    {
      "type": "range",
      "id": "card_corner_radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Card Outer Corner Radius",
      "default": 8
    },
    {
      "type": "range",
      "id": "inner_corner_radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Inner Frame Corner Radius",
      "default": 4
    },
    {
      "type": "range",
      "id": "pill_corner_radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Category Label Pill Radius",
      "default": 4
    },
    {
      "type": "header",
      "content": "Card Spacing & Padding"
    },
    {
      "type": "range",
      "id": "grid_gap_desktop",
      "min": 8,
      "max": 48,
      "step": 4,
      "unit": "px",
      "label": "Grid Gap (Desktop)",
      "default": 24
    },
    {
      "type": "range",
      "id": "grid_gap_mobile",
      "min": 4,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Grid Gap (Mobile)",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_outer_padding",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Card Outer Frame Padding",
      "default": 8
    },
    {
      "type": "range",
      "id": "card_inner_padding",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Card Content Inner Padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "card_height_desktop",
      "min": 350,
      "max": 650,
      "step": 10,
      "unit": "px",
      "label": "Desktop Card Height",
      "default": 540
    },
    {
      "type": "range",
      "id": "card_height_mobile",
      "min": 280,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "Mobile Card Height",
      "default": 420
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Desktop Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Desktop Bottom Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Mobile Top Padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Mobile Bottom Padding",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "category_item",
      "name": "Category Card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Category Image"
        },
        {
          "type": "text",
          "id": "image_url",
          "label": "External Image URL (Unsplash or CDN)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Category Title",
          "default": "DRESSES"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Link / Button Text",
          "default": "Shop Dresses →"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "La Vee Shop by Category",
      "blocks": [
        {
          "type": "category_item",
          "settings": {
            "title": "DRESSES",
            "button_text": "Shop Dresses →",
            "image_url": "https://images.unsplash.com/photo-1708434034707-0580ada65d8d?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&w=1080"
          }
        },
        {
          "type": "category_item",
          "settings": {
            "title": "MATCHING SETS",
            "button_text": "Shop Sets →",
            "image_url": "https://images.unsplash.com/photo-1773574488217-eb936b733cae?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&w=1080"
          }
        },
        {
          "type": "category_item",
          "settings": {
            "title": "TOPS & CORSETS",
            "button_text": "Shop Tops →",
            "image_url": "https://images.unsplash.com/photo-1710090411838-5f846e289b2e?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&w=1080"
          }
        },
        {
          "type": "category_item",
          "settings": {
            "title": "OCCASIONWEAR",
            "button_text": "Shop Occasion →",
            "image_url": "https://images.unsplash.com/photo-1593530097577-bbf5f393ad7a?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&w=1080"
          }
        }
      ]
    }
  ]
}
{% endschema %}
