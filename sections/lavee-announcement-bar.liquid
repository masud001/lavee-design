{{ 'lavee-header-footer.css' | asset_url | stylesheet_tag }}

{% comment %}
  La Vee Luxury Announcement Bar - Node ID: twkN3
{% endcomment %}

<div class="lavee-announcement-bar" style="background-color: {{ section.settings.bg_color }};">
  {%- if section.settings.text != blank -%}
    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}" class="lavee-announcement-bar__text" style="color: {{ section.settings.text_color }};">
        {{ section.settings.text }}
      </a>
    {%- else -%}
      <p class="lavee-announcement-bar__text" style="color: {{ section.settings.text_color }};">
        {{ section.settings.text }}
      </p>
    {%- endif -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "La Vee Announcement Bar",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "Announcement Text",
      "default": "COMPLIMENTARY EXPRESS SHIPPING ON ORDERS OVER $150 — EXPLORE NEW IN"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Announcement Link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#EDE6DC"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#161616"
    }
  ],
  "presets": [
    {
      "name": "La Vee Announcement Bar"
    }
  ]
}
{% endschema %}
