{{ 'lavee-header-footer.css' | asset_url | stylesheet_tag }}

{% comment %}
  La Vee Luxury Announcement Bar with Infinite Marquee Animation - Node ID: twkN3 & XBJqN
  - Layout Width Option: Container vs Container Fluid
  - Responsive across Mobile, Tablet, Desktop
  - Independent Mobile Font Size & Letter Spacing Controls
  - Accessible (a11y), Pauses on Hover & Focus
  - Prefers-Reduced-Motion Support
  - Merchant Customizations: Padding, Colors, Speed, Block Gaps
{% endcomment %}

{%- style -%}
  #shopify-section-{{ section.id }} .lavee-announcement-bar {
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-bottom: 1px solid {{ section.settings.border_color }};
  }

  #shopify-section-{{ section.id }} .lavee-marquee__track {
    animation-duration: {{ section.settings.marquee_speed }}s;
    gap: {{ section.settings.block_gap }}px;
  }

  #shopify-section-{{ section.id }} .lavee-marquee__item {
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.font_size }}px;
    font-weight: {{ section.settings.font_weight }};
    letter-spacing: {{ section.settings.letter_spacing }}em;
  }

  #shopify-section-{{ section.id }} .lavee-marquee__item a {
    color: {{ section.settings.text_color }};
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} .lavee-announcement-bar {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    #shopify-section-{{ section.id }} .lavee-marquee__track {
      gap: {{ section.settings.block_gap_mobile }}px;
    }

    #shopify-section-{{ section.id }} .lavee-marquee__item {
      font-size: {{ section.settings.font_size_mobile }}px;
      letter-spacing: {{ section.settings.letter_spacing_mobile }}em;
    }
  }
{%- endstyle -%}

<div 
  class="lavee-announcement-bar lavee-marquee-wrapper" 
  role="region" 
  aria-label="{{ 'sections.header.announcement' | t | default: 'Announcement Bar' }}"
>
  <div class="lavee-{{ section.settings.container_type }}">
    <div class="lavee-marquee">
      <!-- Duplicate tracks for seamless infinite loop -->
      <div class="lavee-marquee__track" aria-hidden="false">
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            <div class="lavee-marquee__item" {{ block.shopify_attributes }}>
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}" class="lavee-marquee__link focus-inset">
                  <span>{{ block.settings.text }}</span>
                </a>
              {%- else -%}
                <span>{{ block.settings.text }}</span>
              {%- endif -%}
              <span class="lavee-marquee__separator" aria-hidden="true">•</span>
            </div>
          {%- endfor -%}
        {%- else -%}
          <!-- Fallback Default Announcements -->
          <div class="lavee-marquee__item">
            <span>COMPLIMENTARY EXPRESS SHIPPING ON ORDERS OVER $150 — EXPLORE NEW IN</span>
            <span class="lavee-marquee__separator" aria-hidden="true">•</span>
          </div>
          <div class="lavee-marquee__item">
            <span>AUTUMN / WINTER 2026 COLLECTION HAS OFFICIALLY LANDED</span>
            <span class="lavee-marquee__separator" aria-hidden="true">•</span>
          </div>
          <div class="lavee-marquee__item">
            <span>JOIN LA VEE ATELIER PRIVÉ FOR 15% OFF YOUR FIRST ORDER</span>
            <span class="lavee-marquee__separator" aria-hidden="true">•</span>
          </div>
        {%- endif -%}
      </div>

      <!-- Duplicate track 2 for continuous loop -->
      <div class="lavee-marquee__track" aria-hidden="true">
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            <div class="lavee-marquee__item">
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}" class="lavee-marquee__link focus-inset" tabindex="-1">
                  <span>{{ block.settings.text }}</span>
                </a>
              {%- else -%}
                <span>{{ block.settings.text }}</span>
              {%- endif -%}
              <span class="lavee-marquee__separator" aria-hidden="true">•</span>
            </div>
          {%- endfor -%}
        {%- else -%}
          <div class="lavee-marquee__item">
            <span>COMPLIMENTARY EXPRESS SHIPPING ON ORDERS OVER $150 — EXPLORE NEW IN</span>
            <span class="lavee-marquee__separator" aria-hidden="true">•</span>
          </div>
          <div class="lavee-marquee__item">
            <span>AUTUMN / WINTER 2026 COLLECTION HAS OFFICIALLY LANDED</span>
            <span class="lavee-marquee__separator" aria-hidden="true">•</span>
          </div>
          <div class="lavee-marquee__item">
            <span>JOIN LA VEE ATELIER PRIVÉ FOR 15% OFF YOUR FIRST ORDER</span>
            <span class="lavee-marquee__separator" aria-hidden="true">•</span>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "La Vee Announcement Bar",
  "class": "lavee-announcement-bar-section",
  "settings": [
    {
      "type": "header",
      "content": "Layout Width"
    },
    {
      "type": "select",
      "id": "container_type",
      "label": "Section Width Type",
      "options": [
        { "value": "container-fluid", "label": "Container Fluid (Full Width - 100%)" },
        { "value": "container", "label": "Container (Fixed Width / Centered)" }
      ],
      "default": "container-fluid"
    },
    {
      "type": "header",
      "content": "Appearance & Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#EDE6DC"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#161616"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Bottom Border Color",
      "default": "#D8D2CA"
    },
    {
      "type": "header",
      "content": "Desktop Typography"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 10,
      "max": 16,
      "step": 1,
      "unit": "px",
      "label": "Desktop Font Size",
      "default": 12
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font Weight",
      "options": [
        { "value": "400", "label": "Normal (400)" },
        { "value": "500", "label": "Medium (500)" },
        { "value": "600", "label": "Semi-Bold (600)" },
        { "value": "700", "label": "Bold (700)" }
      ],
      "default": "600"
    },
    {
      "type": "select",
      "id": "letter_spacing",
      "label": "Desktop Letter Spacing",
      "options": [
        { "value": "0", "label": "Normal (0em)" },
        { "value": "0.04", "label": "Subtle (0.04em)" },
        { "value": "0.08", "label": "Luxury Spacing (0.08em)" },
        { "value": "0.12", "label": "Wide (0.12em)" }
      ],
      "default": "0.08"
    },
    {
      "type": "header",
      "content": "Mobile Typography"
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "min": 8,
      "max": 14,
      "step": 1,
      "unit": "px",
      "label": "Mobile Font Size",
      "default": 10
    },
    {
      "type": "select",
      "id": "letter_spacing_mobile",
      "label": "Mobile Letter Spacing",
      "options": [
        { "value": "0", "label": "Normal (0em)" },
        { "value": "0.04", "label": "Subtle (0.04em)" },
        { "value": "0.06", "label": "Mobile Luxury (0.06em)" },
        { "value": "0.08", "label": "Luxury Spacing (0.08em)" },
        { "value": "0.12", "label": "Wide (0.12em)" }
      ],
      "default": "0.06"
    },
    {
      "type": "header",
      "content": "Animation & Gaps"
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "min": 5,
      "max": 60,
      "step": 5,
      "unit": "s",
      "label": "Marquee Animation Speed",
      "default": 25
    },
    {
      "type": "range",
      "id": "block_gap",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Desktop Gap Between Blocks",
      "default": 36
    },
    {
      "type": "range",
      "id": "block_gap_mobile",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Mobile Gap Between Blocks",
      "default": 20
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 6
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 6
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement Text",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Announcement Text",
          "default": "COMPLIMENTARY EXPRESS SHIPPING ON ORDERS OVER $150 — EXPLORE NEW IN"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "La Vee Announcement Bar",
      "blocks": [
        {
          "type": "announcement",
          "settings": {
            "text": "COMPLIMENTARY EXPRESS SHIPPING ON ORDERS OVER $150 — EXPLORE NEW IN"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "AUTUMN / WINTER 2026 COLLECTION HAS OFFICIALLY LANDED"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "JOIN LA VEE ATELIER PRIVÉ FOR 15% OFF YOUR FIRST ORDER"
          }
        }
      ]
    }
  ]
}
{% endschema %}
