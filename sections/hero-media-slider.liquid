{{ 'section-hero-media-slider.css' | asset_url | stylesheet_tag }}

{%- style -%}
  @media screen and (max-width: 768px) {
    {%- if section.settings.section_height_mobile == 'custom' -%}
      #shopify-section-{{ section.id }} .lavee-hero-wrapper {
        height: {{ section.settings.section_height_mobile_custom }}px !important;
        min-height: {{ section.settings.section_height_mobile_custom }}px !important;
      }
    {%- endif -%}
  }
{%- endstyle -%}

<div 
  class="lavee-hero-wrapper lavee-hero-height--{{ section.settings.section_height }} lavee-hero-mobile-height--{{ section.settings.section_height_mobile | default: 'medium' }} lavee-hero-bg--{{ section.settings.background_preset | default: 'burgundy_noir' }}"
  data-section-id="{{ section.id }}"
  data-autoplay="{{ section.settings.autoplay }}"
  data-speed="{{ section.settings.autoplay_speed }}"
>
  <div class="lavee-{{ section.settings.container_type }}" style="height: 100%;">
    <div class="lavee-hero-slider" id="LaveeHeroSlider-{{ section.id }}">
      
      <!-- Main Slides Track -->
      <div class="lavee-hero-slider__track" id="LaveeHeroTrack-{{ section.id }}">
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            <div 
              class="lavee-hero-slide{% if forloop.first %} is-active{% endif %} lavee-hero-slide--align-{{ block.settings.content_alignment | default: 'left' }}" 
              data-index="{{ forloop.index0 }}"
              {{ block.shopify_attributes }}
            >
              <!-- Media Layer (Video or Image) -->
              <div class="lavee-hero-slide__media">
                {%- if block.settings.video != blank -%}
                  {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, class: 'lavee-hero-video' }}
                {%- elsif block.settings.video_url != blank -%}
                  <video autoplay loop muted playsinline class="lavee-hero-video">
                    <source src="{{ block.settings.video_url }}" type="video/mp4">
                  </video>
                {%- elsif block.settings.image != blank -%}
                  {%- if forloop.first -%}
                    {{ block.settings.image | image_url: width: 2200 | image_tag: alt: block.settings.heading, loading: 'eager', fetchpriority: 'high' }}
                  {%- else -%}
                    {{ block.settings.image | image_url: width: 2200 | image_tag: alt: block.settings.heading, loading: 'lazy' }}
                  {%- endif -%}
                {%- else -%}
                  <div class="lavee-hero-slide__fallback" style="background-color: #3E151A; width: 100%; height: 100%;"></div>
                {%- endif -%}
              </div>

              <!-- Dark Overlay Layer -->
              <div 
                class="lavee-hero-slide__overlay" 
                style="background: linear-gradient(180deg, rgba(22, 22, 22, {{ section.settings.overlay_opacity | divided_by: 2.0 | divided_by: 100.0 }}) 0%, rgba(22, 22, 22, {{ section.settings.overlay_opacity | divided_by: 100.0 }}) 100%);"
              ></div>

              <!-- Slide Content Box -->
              <div class="lavee-hero-slide__content">
                {%- if block.settings.eyebrow != blank -%}
                  <span class="lavee-hero-eyebrow">{{ block.settings.eyebrow | escape }}</span>
                {%- endif -%}

                {%- if block.settings.heading != blank -%}
                  <h1 class="lavee-hero-title">{{ block.settings.heading | escape }}</h1>
                {%- endif -%}

                {%- if block.settings.subtext != blank -%}
                  <p class="lavee-hero-subtext">{{ block.settings.subtext | escape }}</p>
                {%- endif -%}

                {%- if block.settings.button_primary_label != blank or block.settings.button_secondary_label != blank -%}
                  <div class="lavee-hero-buttons">
                    {%- if block.settings.button_primary_label != blank -%}
                      <a href="{{ block.settings.button_primary_link | default: routes.all_products_collection_url }}" class="lavee-hero-btn lavee-hero-btn--primary">
                        {{ block.settings.button_primary_label | escape }}
                        <span class="lavee-hero-btn-arrow">→</span>
                      </a>
                    {%- endif -%}

                    {%- if block.settings.button_secondary_label != blank -%}
                      <a href="{{ block.settings.button_secondary_link | default: routes.collections_url }}" class="lavee-hero-btn lavee-hero-btn--secondary">
                        <span class="lavee-hero-btn-icon">►</span>
                        {{ block.settings.button_secondary_label | escape }}
                      </a>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        {%- else -%}
          <!-- Default Fallback Slide -->
          <div class="lavee-hero-slide is-active lavee-hero-slide--align-left" data-index="0">
            <div class="lavee-hero-slide__media" style="background-color: #3E151A;"></div>
            <div class="lavee-hero-slide__overlay" style="background: rgba(22,22,22,0.5);"></div>
            <div class="lavee-hero-slide__content">
              <span class="lavee-hero-eyebrow">LA VEE ATELIER — EXCLUSIVE CAMPAIGN</span>
              <h1 class="lavee-hero-title">Made to Be Remembered.</h1>
              <p class="lavee-hero-subtext">Experience our Autumn/Winter 2026 Video Campaign. Sculpted silhouettes, liquid silks, and dramatic eveningwear crafted for iconic entrances.</p>
              <div class="lavee-hero-buttons">
                <a href="{{ routes.all_products_collection_url }}" class="lavee-hero-btn lavee-hero-btn--primary">
                  SHOP THE LOOKBOOK <span class="lavee-hero-btn-arrow">→</span>
                </a>
                <a href="{{ routes.collections_url }}" class="lavee-hero-btn lavee-hero-btn--secondary">
                  <span class="lavee-hero-btn-icon">►</span> WATCH FULL FILM (2:45)
                </a>
              </div>
            </div>
          </div>
        {%- endif -%}
      </div>

      <!-- Bottom Bar Controls: Slide Counter, Nav Arrows, Line Progress, Audio Toggle & Slide Selector Tabs -->
      {%- assign total_slides = section.blocks.size -%}
      {%- if total_slides == 0 -%}{%- assign total_slides = 4 -%}{%- endif -%}
      
      <div class="lavee-hero-controls-bottom">
        {%- if section.settings.show_nav_controls -%}
          <!-- Left Side: Nav Arrows + Counter + Line Progress Bar -->
          <div class="lavee-hero-controls-left">
            <div class="lavee-hero-nav-btns">
              <button 
                type="button" 
                class="lavee-hero-nav-btn lavee-hero-nav-btn--prev" 
                aria-label="Previous Slide"
                onclick="prevLaveeHeroSlide('{{ section.id }}')"
              >
                ‹
              </button>
            </div>

            <div class="lavee-hero-counter">
              <span class="lavee-hero-counter__current" id="LaveeHeroCurrent-{{ section.id }}">01</span>
              <span class="lavee-hero-counter__divider">/</span>
              <span class="lavee-hero-counter__total">0{{ total_slides }}</span>
            </div>

            <div class="lavee-hero-nav-btns">
              <button 
                type="button" 
                class="lavee-hero-nav-btn lavee-hero-nav-btn--next" 
                aria-label="Next Slide"
                onclick="nextLaveeHeroSlide('{{ section.id }}')"
              >
                ›
              </button>
            </div>

            <!-- Line Progress Bar -->
            <div class="lavee-hero-progress-track">
              <div class="lavee-hero-progress-bar" id="LaveeHeroProgress-{{ section.id }}"></div>
            </div>
          </div>
        {%- endif -%}

        {%- if section.settings.show_audio_control -%}
          <!-- Center Audio/Video Control Toggle Button (Hero Section Niche) -->
          <div class="lavee-hero-controls-audio-wrapper">
            <button 
              type="button" 
              class="lavee-hero-audio-btn" 
              id="LaveeHeroAudioBtn-{{ section.id }}"
              aria-label="Toggle Audio"
              onclick="toggleLaveeHeroAudio(this)"
            >
              <span class="lavee-hero-audio-icon">🔇</span>
              <span class="lavee-hero-audio-text">SOUND OFF</span>
            </button>
          </div>
        {%- endif -%}

        {%- if section.settings.show_slide_tabs -%}
          <!-- Right Side: Slide Selector Tabs (Desktop Spec) -->
          <div class="lavee-hero-tabs" id="LaveeHeroTabs-{{ section.id }}">
            {%- if section.blocks.size > 0 -%}
              {%- for block in section.blocks -%}
                <button 
                  type="button"
                  class="lavee-hero-tab-pill{% if forloop.first %} is-active{% endif %}"
                  data-slide-target="{{ forloop.index0 }}"
                  onclick="goToLaveeHeroSlide('{{ section.id }}', {{ forloop.index0 }})"
                >
                  <span class="lavee-hero-tab-pill__icon">
                    {%- if block.settings.video != blank or block.settings.video_url != blank -%}
                      ►
                    {%- else -%}
                      📷
                    {%- endif -%}
                  </span>
                  <span class="lavee-hero-tab-pill__title">
                    {{ block.settings.tab_title | default: block.settings.heading | default: 'Slide' }}
                  </span>
                </button>
              {%- endfor -%}
            {%- else -%}
              <!-- Fallback Pen.dev Design Tabs -->
              <button type="button" class="lavee-hero-tab-pill is-active" onclick="goToLaveeHeroSlide('{{ section.id }}', 0)">
                <span class="lavee-hero-tab-pill__icon">►</span>
                <span class="lavee-hero-tab-pill__title">01. Campaign Film</span>
              </button>
              <button type="button" class="lavee-hero-tab-pill" onclick="goToLaveeHeroSlide('{{ section.id }}', 1)">
                <span class="lavee-hero-tab-pill__icon">📷</span>
                <span class="lavee-hero-tab-pill__title">02. Silk Gowns</span>
              </button>
              <button type="button" class="lavee-hero-tab-pill" onclick="goToLaveeHeroSlide('{{ section.id }}', 2)">
                <span class="lavee-hero-tab-pill__icon">📷</span>
                <span class="lavee-hero-tab-pill__title">03. Atelier Craft</span>
              </button>
              <button type="button" class="lavee-hero-tab-pill" onclick="goToLaveeHeroSlide('{{ section.id }}', 3)">
                <span class="lavee-hero-tab-pill__icon">►</span>
                <span class="lavee-hero-tab-pill__title">04. Tailored Edit</span>
              </button>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.show_mobile_pagination -%}
          <!-- Mobile Pagination Dots (Replaces Tabs on Mobile Spec) -->
          <div class="lavee-hero-pagination" id="LaveeHeroPagination-{{ section.id }}" aria-label="Slide Pagination">
            {%- if section.blocks.size > 0 -%}
              {%- for block in section.blocks -%}
                <button 
                  type="button" 
                  class="lavee-hero-pagination-dot{% if forloop.first %} is-active{% endif %}"
                  aria-label="Go to slide {{ forloop.index }}"
                  onclick="goToLaveeHeroSlide('{{ section.id }}', {{ forloop.index0 }})"
                ></button>
              {%- endfor -%}
            {%- else -%}
              <button type="button" class="lavee-hero-pagination-dot is-active" aria-label="Go to slide 1" onclick="goToLaveeHeroSlide('{{ section.id }}', 0)"></button>
              <button type="button" class="lavee-hero-pagination-dot" aria-label="Go to slide 2" onclick="goToLaveeHeroSlide('{{ section.id }}', 1)"></button>
              <button type="button" class="lavee-hero-pagination-dot" aria-label="Go to slide 3" onclick="goToLaveeHeroSlide('{{ section.id }}', 2)"></button>
              <button type="button" class="lavee-hero-pagination-dot" aria-label="Go to slide 4" onclick="goToLaveeHeroSlide('{{ section.id }}', 3)"></button>
            {%- endif -%}
          </div>
        {%- endif -%}

      </div>

    </div>
  </div>
</div>

<script>
  function toggleLaveeHeroAudio(btn) {
    if (btn.hasAttribute('disabled') || btn.classList.contains('is-disabled')) return;
    const slider = btn.closest('.lavee-hero-wrapper');
    if (!slider) return;
    const mediaElements = slider.querySelectorAll('video, audio');
    if (!mediaElements.length) return;
    
    const icon = btn.querySelector('.lavee-hero-audio-icon');
    const text = btn.querySelector('.lavee-hero-audio-text');
    const wasMuted = mediaElements[0].muted;
    
    mediaElements.forEach(m => {
      m.muted = !wasMuted;
      if (!m.muted) {
        m.play().catch(() => {});
      }
    });
    
    if (wasMuted) {
      if (icon) icon.textContent = '🔊';
      if (text) text.textContent = 'SOUND ON';
    } else {
      if (icon) icon.textContent = '🔇';
      if (text) text.textContent = 'SOUND OFF';
    }
  }

  function initLaveeHeroSlider(sectionId) {
    const wrapper = document.querySelector(`[data-section-id="${sectionId}"]`);
    if (!wrapper) return;
    
    const track = wrapper.querySelector('#LaveeHeroTrack-' + sectionId);
    const slides = wrapper.querySelectorAll('.lavee-hero-slide');
    const counterCurrent = wrapper.querySelector('#LaveeHeroCurrent-' + sectionId);
    const progressBar = wrapper.querySelector('#LaveeHeroProgress-' + sectionId);
    const tabPills = wrapper.querySelectorAll('.lavee-hero-tab-pill');
    const paginationDots = wrapper.querySelectorAll('.lavee-hero-pagination-dot');
    const audioBtn = wrapper.querySelector('#LaveeHeroAudioBtn-' + sectionId) || wrapper.querySelector('.lavee-hero-audio-btn');
    
    if (!slides.length) return;
    
    // Ensure all videos/audios are muted by default
    wrapper.querySelectorAll('video, audio').forEach(v => {
      v.muted = true;
    });
    
    let currentIndex = 0;
    const totalSlides = slides.length;
    const isAutoplay = wrapper.dataset.autoplay === 'true';
    const speedSeconds = parseInt(wrapper.dataset.speed) || 5;
    let progressTimer = null;
    
    function animateLaveeSlideContent(activeSlide) {
      if (!activeSlide) return;
      
      slides.forEach(slide => {
        if (slide !== activeSlide) {
          const inactiveElements = slide.querySelectorAll('.lavee-hero-eyebrow, .lavee-hero-title, .lavee-hero-subtext, .lavee-hero-buttons');
          if (typeof gsap !== 'undefined') {
            gsap.set(inactiveElements, { opacity: 0, scale: 0.85, y: 0 });
          }
        }
      });

      const activeElements = activeSlide.querySelectorAll('.lavee-hero-eyebrow, .lavee-hero-title, .lavee-hero-subtext, .lavee-hero-buttons');
      if (typeof gsap !== 'undefined') {
        gsap.killTweensOf(activeElements);
        gsap.fromTo(
          activeElements,
          { opacity: 0, scale: 0.84, y: 0, transformOrigin: 'center center' },
          {
            opacity: 1,
            scale: 1,
            y: 0,
            duration: 0.85,
            stagger: 0.1,
            ease: 'back.out(1.4)',
            overwrite: 'auto'
          }
        );

        const activeMedia = activeSlide.querySelector('.lavee-hero-slide__media img, .lavee-hero-slide__media video');
        if (activeMedia) {
          gsap.killTweensOf(activeMedia);
          gsap.fromTo(
            activeMedia,
            { scale: 1.15 },
            { scale: 1.0, duration: 1.4, ease: 'power2.out', overwrite: 'auto' }
          );
        }
      }
    }

    function updateSlide(index) {
      if (index < 0) index = totalSlides - 1;
      if (index >= totalSlides) index = 0;
      
      currentIndex = index;
      if (track) {
        track.style.transform = `translateX(-${currentIndex * 100}%)`;
      }
      
      slides.forEach((slide, idx) => {
        slide.classList.toggle('is-active', idx === currentIndex);
      });
      
      tabPills.forEach((pill, idx) => {
        pill.classList.toggle('is-active', idx === currentIndex);
      });

      paginationDots.forEach((dot, idx) => {
        dot.classList.toggle('is-active', idx === currentIndex);
      });
      
      if (counterCurrent) {
        counterCurrent.textContent = (currentIndex + 1 < 10 ? '0' : '') + (currentIndex + 1);
      }

      // Run GSAP entrance animation for active slide content
      animateLaveeSlideContent(slides[currentIndex]);
      
      // Update Audio Control Button enable/disable state based on video/audio presence
      if (audioBtn) {
        const activeSlide = slides[currentIndex];
        const activeMedia = activeSlide ? activeSlide.querySelector('video, audio') : null;
        const anyMedia = wrapper.querySelector('video, audio');
        
        if (activeMedia) {
          audioBtn.removeAttribute('disabled');
          audioBtn.classList.remove('is-disabled');
          audioBtn.style.opacity = '1';
          audioBtn.style.pointerEvents = 'auto';
          
          const isMuted = activeMedia.muted;
          const icon = audioBtn.querySelector('.lavee-hero-audio-icon');
          const text = audioBtn.querySelector('.lavee-hero-audio-text');
          if (icon) icon.textContent = isMuted ? '🔇' : '🔊';
          if (text) text.textContent = isMuted ? 'SOUND OFF' : 'SOUND ON';
        } else if (anyMedia) {
          audioBtn.setAttribute('disabled', 'true');
          audioBtn.classList.add('is-disabled');
          audioBtn.style.opacity = '0.4';
          audioBtn.style.pointerEvents = 'none';
        } else {
          audioBtn.setAttribute('disabled', 'true');
          audioBtn.classList.add('is-disabled');
          audioBtn.style.opacity = '0.4';
          audioBtn.style.pointerEvents = 'none';
        }
      }
      
      resetProgress();
    }
    
    function resetProgress() {
      if (!progressBar) return;
      
      if (typeof gsap !== 'undefined') {
        gsap.killTweensOf(progressBar);
        gsap.set(progressBar, { width: '0%' });
        
        if (isAutoplay && totalSlides > 1) {
          gsap.to(progressBar, {
            width: '100%',
            duration: speedSeconds,
            ease: 'none',
            onComplete: function() {
              updateSlide(currentIndex + 1);
            }
          });
        } else {
          gsap.set(progressBar, { width: '100%' });
        }
      } else {
        if (progressTimer) clearTimeout(progressTimer);
        progressBar.style.transition = 'none';
        progressBar.style.width = '0%';
        
        if (isAutoplay && totalSlides > 1) {
          setTimeout(() => {
            progressBar.style.transition = `width ${speedSeconds}s linear`;
            progressBar.style.width = '100%';
          }, 30);
          
          progressTimer = setTimeout(() => {
            updateSlide(currentIndex + 1);
          }, speedSeconds * 1000);
        } else {
          progressBar.style.width = '100%';
        }
      }
    }
    
    window['prevLaveeHeroSlide_' + sectionId] = function() {
      updateSlide(currentIndex - 1);
    };
    
    window['nextLaveeHeroSlide_' + sectionId] = function() {
      updateSlide(currentIndex + 1);
    };

    window['goToLaveeHeroSlide_' + sectionId] = function(idx) {
      updateSlide(idx);
    };

    // Touch Swipe Support
    let touchStartX = 0;
    let touchEndX = 0;
    
    wrapper.addEventListener('touchstart', e => {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });
    
    wrapper.addEventListener('touchend', e => {
      touchEndX = e.changedTouches[0].screenX;
      if (touchStartX - touchEndX > 50) {
        updateSlide(currentIndex + 1);
      } else if (touchEndX - touchStartX > 50) {
        updateSlide(currentIndex - 1);
      }
    }, { passive: true });
    
    updateSlide(0);
  }

  function prevLaveeHeroSlide(id) {
    if (window['prevLaveeHeroSlide_' + id]) {
      window['prevLaveeHeroSlide_' + id]();
    }
  }

  function nextLaveeHeroSlide(id) {
    if (window['nextLaveeHeroSlide_' + id]) {
      window['nextLaveeHeroSlide_' + id]();
    }
  }

  function goToLaveeHeroSlide(id, index) {
    if (window['goToLaveeHeroSlide_' + id]) {
      window['goToLaveeHeroSlide_' + id](index);
    }
  }

  document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.lavee-hero-wrapper').forEach(wrapper => {
      const sectionId = wrapper.dataset.sectionId;
      if (sectionId) initLaveeHeroSlider(sectionId);
    });
  });

  document.addEventListener('shopify:section:load', function(e) {
    const wrapper = e.target.querySelector('.lavee-hero-wrapper');
    if (wrapper && wrapper.dataset.sectionId) {
      initLaveeHeroSlider(wrapper.dataset.sectionId);
    }
  });
</script>

{% schema %}
{
  "name": "La Vee Hero Slider",
  "tag": "section",
  "class": "lavee-hero-slider-section",
  "settings": [
    {
      "type": "header",
      "content": "Layout & Container Width"
    },
    {
      "type": "select",
      "id": "container_type",
      "label": "Section Width Type",
      "options": [
        { "value": "container-fluid", "label": "Container Fluid (Full Width - 100%)" },
        { "value": "container", "label": "Container (Fixed Width / Centered)" }
      ],
      "default": "container-fluid"
    },
    {
      "type": "select",
      "id": "section_height",
      "label": "Desktop Section Height Preset",
      "options": [
        { "value": "fullscreen", "label": "Full Screen (100vh)" },
        { "value": "large", "label": "Large (800px)" },
        { "value": "medium", "label": "Medium (650px)" }
      ],
      "default": "fullscreen"
    },
    {
      "type": "select",
      "id": "section_height_mobile",
      "label": "Mobile Section Height Preset",
      "options": [
        { "value": "fullscreen", "label": "Mobile Full Screen (100vh)" },
        { "value": "large", "label": "Mobile Large (620px)" },
        { "value": "medium", "label": "Mobile Medium (520px)" },
        { "value": "small", "label": "Mobile Compact (440px)" },
        { "value": "custom", "label": "Custom Pixel Height (Set Slider Below)" }
      ],
      "default": "medium"
    },
    {
      "type": "range",
      "id": "section_height_mobile_custom",
      "min": 280,
      "max": 850,
      "step": 10,
      "unit": "px",
      "label": "Mobile Custom Height (px)",
      "info": "Applies when Mobile Height Preset is set to Custom",
      "default": 520
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Dark Overlay Opacity",
      "default": 40
    },
    {
      "type": "select",
      "id": "background_preset",
      "label": "Luxury Background Aesthetic Preset",
      "options": [
        { "value": "burgundy_noir", "label": "Haute Couture Burgundy & Ebony Noir (Default)" },
        { "value": "deep_espresso", "label": "Deep Velvet Espresso & Amber Noir" },
        { "value": "midnight_plum", "label": "Midnight Royal Plum & Slate Noir" }
      ],
      "default": "burgundy_noir"
    },
    {
      "type": "header",
      "content": "Hero Controls Toggle Settings"
    },
    {
      "type": "checkbox",
      "id": "show_audio_control",
      "label": "Show Audio / Video Control Button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_nav_controls",
      "label": "Show Navigation Arrows & Counter",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_slide_tabs",
      "label": "Show Slide Selector Tabs",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_mobile_pagination",
      "label": "Show Mobile Pagination Dots",
      "default": true
    },
    {
      "type": "header",
      "content": "Autoplay & Timing"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable Slide Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Autoplay Duration",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Campaign Slide",
