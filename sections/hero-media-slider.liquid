{% comment %}
  La Vee Storefront - Hero Media Slider Section
  Supports theme blocks and section blocks for video & image slides.
{% endcomment %}

{{ 'section-hero-media-slider.css' | asset_url | stylesheet_tag }}

<div class="hero-media-slider relative w-full overflow-hidden bg-[#161616] section-{{ section.id }}-padding">
  <div class="hero-media-slider__container relative w-full h-full" data-hero-slider>
    <div class="hero-media-slider__slides flex transition-transform duration-500 ease-out" data-slider-slides>
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <div class="hero-media-slider__slide w-full flex-shrink-0" {{ block.shopify_attributes }}>
            {%- case block.type -%}
              {%- when 'slide' -%}
                <div class="hero-slide relative overflow-hidden flex items-center justify-center min-h-[520px] lg:min-h-[760px] w-full">
                  {%- if block.settings.video != blank -%}
                    <div class="hero-slide__media absolute inset-0 w-full h-full">
                      {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, class: 'w-full h-full object-cover' }}
                    </div>
                  {%- elsif block.settings.image != blank -%}
                    <div class="hero-slide__media absolute inset-0 w-full h-full">
                      <img
                        src="{{ block.settings.image | image_url: width: 2000 }}"
                        alt="{{ block.settings.heading | escape }}"
                        loading="lazy"
                        class="w-full h-full object-cover"
                        width="2000"
                        height="1000"
                      >
                    </div>
                  {%- else -%}
                    <div class="hero-slide__media absolute inset-0 w-full h-full bg-[#3E151A]"></div>
                  {%- endif -%}

                  <div class="hero-slide__overlay absolute inset-0 bg-black/40"></div>

                  <div class="hero-slide__content relative z-10 text-center text-white px-6 max-w-4xl mx-auto py-20 flex flex-col items-center">
                    {%- if block.settings.eyebrow != blank -%}
                      <span class="hero-slide__eyebrow uppercase tracking-[0.2em] text-xs md:text-sm font-semibold mb-4 text-[#EDE6DC]">
                        {{ block.settings.eyebrow | escape }}
                      </span>
                    {%- endif -%}

                    {%- if block.settings.heading != blank -%}
                      <h2 class="hero-slide__heading font-serif text-3xl md:text-5xl lg:text-7xl font-normal leading-tight mb-6">
                        {{ block.settings.heading | escape }}
                      </h2>
                    {%- endif -%}

                    {%- if block.settings.subtext != blank -%}
                      <p class="hero-slide__subtext text-sm md:text-base lg:text-lg text-[#F7F4EF]/90 max-w-2xl mb-8 leading-relaxed">
                        {{ block.settings.subtext | escape }}
                      </p>
                    {%- endif -%}

                    {%- if block.settings.button_label != blank -%}
                      <a
                        href="{{ block.settings.button_link | default: '#' }}"
                        class="hero-slide__button inline-block bg-[#161616] hover:bg-[#333333] border border-white/20 text-white px-8 py-4 text-xs md:text-sm font-semibold uppercase tracking-widest transition-all duration-200"
                      >
                        {{ block.settings.button_label | escape }}
                      </a>
                    {%- endif -%}
                  </div>
                </div>
            {%- endcase -%}
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- content_for 'blocks' -%}
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 1 -%}
      <button class="hero-media-slider__nav hero-media-slider__nav--prev absolute left-4 top-1/2 -translate-y-1/2 z-20 w-12 h-12 flex items-center justify-center bg-black/40 hover:bg-black/70 text-white rounded-full transition-colors" data-slider-prev aria-label="Previous slide">
        ‹
      </button>
      <button class="hero-media-slider__nav hero-media-slider__nav--next absolute right-4 top-1/2 -translate-y-1/2 z-20 w-12 h-12 flex items-center justify-center bg-black/40 hover:bg-black/70 text-white rounded-full transition-colors" data-slider-next aria-label="Next slide">
        ›
      </button>

      <div class="hero-media-slider__dots absolute bottom-6 left-1/2 -translate-x-1/2 z-20 flex gap-2" data-slider-dots>
        {%- for block in section.blocks -%}
          <button class="hero-media-slider__dot w-3 h-3 rounded-full bg-white/50 hover:bg-white transition-opacity {% if forloop.first %}is-active bg-white{% endif %}" data-slide-index="{{ forloop.index0 }}" aria-label="Go to slide {{ forloop.index }}"></button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Hero Media Slider",
  "tag": "section",
  "class": "section-hero-media-slider",
  "settings": [
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Autoplay Speed",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Slide Image"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Background Video"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow Text",
          "default": "AUTUMN/WINTER COUTURE 2026"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Timeless Elegance & Sculpted Luxury"
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "Subtext",
          "default": "Discover bespoke corsetry, hand-beaded gowns, and tailored couture silhouettes."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "EXPLORE THE COLLECTION"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Media Slider",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "eyebrow": "AUTUMN/WINTER COUTURE 2026",
            "heading": "Naima Hand-Beaded Corset Mini",
            "subtext": "Designed in London. Crafted with precision corsetry and crystal embellishments.",
            "button_label": "SHOP THE NAIMA DRESS"
          }
        },
        {
          "type": "slide",
          "settings": {
            "eyebrow": "ATELIER EVENING GOWNS",
            "heading": "Sculpted Silhouette Collection",
            "subtext": "Empowering confidence through internal structure and Italian silk satin.",
            "button_label": "VIEW GOWNS"
          }
        }
      ]
    }
  ]
}
{% endschema %}
