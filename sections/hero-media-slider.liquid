            "button_primary_label": "SHOP ATELIER NOW",
            "button_secondary_label": "DISCOVER MORE"
          }
        },
        {
          "type": "slide",
          "settings": {
            "tab_title": "04. Tailored Edit",
            "content_alignment": "left",
            "eyebrow": "THE TAILORED SUIT",
            "heading": "Sculpted Power Tailoring",
            "subtext": "Sharp blazers, high-waisted trousers, and structured modern luxury separates.",
            "button_primary_label": "SHOP TAILORED EDIT",
            "button_secondary_label": "EXPLORE SUITS"
          }
        }
      ]
    }
  ]
}
{% endschema %}

