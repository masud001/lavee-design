{{ 'section-hero-media-slider.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  La Vee Luxury Hero Media Slider (Campaign Video & Image Slider) - Node ID: B95Eo
  - Responsive Widths: Container Fluid (100% Full Width) vs Container (Max 1440px Centered)
  - Autoplay Campaign Video with Live Badge & Audio Toggle Pill (SOUND: ON / 4K CINEMATIC PRORES)
  - Interactive Slide Tabs at bottom right (01. Campaign Film, 02. Silk Gowns, etc.)
  - Dual CTAs, Entrance Animations, Slide Counter, Line Progress Bar & Touch Swipe
{%- endcomment -%}

<div 
  class="lavee-hero-wrapper lavee-hero-height--{{ section.settings.section_height }}"
  data-section-id="{{ section.id }}"
  data-autoplay="{{ section.settings.autoplay }}"
  data-speed="{{ section.settings.autoplay_speed }}"
>
  <div class="lavee-{{ section.settings.container_type }}" style="height: 100%;">
    <div class="lavee-hero-slider" id="LaveeHeroSlider-{{ section.id }}">
      
      <!-- Top Bar Controls: Live Badge & Audio Toggle Pill -->
      <div class="lavee-hero-controls-top">
        {%- if section.settings.show_live_badge -%}
          <div class="lavee-hero-badge">
            <span class="lavee-hero-badge__dot"></span>
            {{ section.settings.live_badge_text | default: "VIDEO LOOKBOOK • AUTUMN/WINTER 2026" }}
          </div>
        {%- else -%}
          <div></div>
        {%- endif -%}

        <button 
          type="button" 
          class="lavee-hero-audio-btn" 
          aria-label="Toggle Campaign Video Audio"
          onclick="toggleLaveeHeroAudio(this)"
        >
          <span class="lavee-hero-audio-icon">🔊</span>
          <span class="lavee-hero-audio-text">{{ section.settings.audio_btn_text | default: "SOUND: ON | 4K CINEMATIC PRORES" }}</span>
        </button>
      </div>

      <!-- Main Slides Track -->
      <div class="lavee-hero-slider__track" id="LaveeHeroTrack-{{ section.id }}">
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            <div 
              class="lavee-hero-slide{% if forloop.first %} is-active{% endif %} lavee-hero-slide--align-{{ block.settings.content_alignment | default: 'left' }}" 
              data-index="{{ forloop.index0 }}"
              {{ block.shopify_attributes }}
            >
              <!-- Media Layer (Video or Image) -->
              <div class="lavee-hero-slide__media">
                {%- if block.settings.video != blank -%}
                  {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, class: 'lavee-hero-video' }}
                {%- elsif block.settings.video_url != blank -%}
                  <video autoplay loop muted playsinline class="lavee-hero-video">
                    <source src="{{ block.settings.video_url }}" type="video/mp4">
                  </video>
                {%- elsif block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 2200 | image_tag: alt: block.settings.heading, loading: 'lazy' }}
                {%- else -%}
                  <div class="lavee-hero-slide__fallback" style="background-color: #3E151A; width: 100%; height: 100%;"></div>
                {%- endif -%}
              </div>

              <!-- Dark Overlay Layer -->
              <div 
                class="lavee-hero-slide__overlay" 
                style="background: linear-gradient(180deg, rgba(22, 22, 22, {{ section.settings.overlay_opacity | divided_by: 2.0 | divided_by: 100.0 }}) 0%, rgba(22, 22, 22, {{ section.settings.overlay_opacity | divided_by: 100.0 }}) 100%);"
              ></div>

              <!-- Slide Content Box -->
              <div class="lavee-hero-slide__content">
                {%- if block.settings.eyebrow != blank -%}
                  <span class="lavee-hero-eyebrow">{{ block.settings.eyebrow | escape }}</span>
                {%- endif -%}

                {%- if block.settings.heading != blank -%}
                  <h1 class="lavee-hero-title">{{ block.settings.heading | escape }}</h1>
                {%- endif -%}

                {%- if block.settings.subtext != blank -%}
                  <p class="lavee-hero-subtext">{{ block.settings.subtext | escape }}</p>
                {%- endif -%}

                {%- if block.settings.button_primary_label != blank or block.settings.button_secondary_label != blank -%}
                  <div class="lavee-hero-buttons">
                    {%- if block.settings.button_primary_label != blank -%}
                      <a href="{{ block.settings.button_primary_link | default: routes.all_products_collection_url }}" class="lavee-hero-btn lavee-hero-btn--primary">
                        {{ block.settings.button_primary_label | escape }}
                        <span class="lavee-hero-btn-arrow">→</span>
                      </a>
                    {%- endif -%}

                    {%- if block.settings.button_secondary_label != blank -%}
                      <a href="{{ block.settings.button_secondary_link | default: routes.collections_url }}" class="lavee-hero-btn lavee-hero-btn--secondary">
                        <span class="lavee-hero-btn-icon">►</span>
                        {{ block.settings.button_secondary_label | escape }}
                      </a>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        {%- else -%}
          <!-- Default Fallback Slide -->
          <div class="lavee-hero-slide is-active lavee-hero-slide--align-left" data-index="0">
            <div class="lavee-hero-slide__media" style="background-color: #3E151A;"></div>
            <div class="lavee-hero-slide__overlay" style="background: rgba(22,22,22,0.5);"></div>
            <div class="lavee-hero-slide__content">
              <span class="lavee-hero-eyebrow">LA VEE ATELIER — EXCLUSIVE CAMPAIGN</span>
              <h1 class="lavee-hero-title">Made to Be Remembered.</h1>
              <p class="lavee-hero-subtext">Experience our Autumn/Winter 2026 Video Campaign. Sculpted silhouettes, liquid silks, and dramatic eveningwear crafted for iconic entrances.</p>
              <div class="lavee-hero-buttons">
                <a href="{{ routes.all_products_collection_url }}" class="lavee-hero-btn lavee-hero-btn--primary">
                  SHOP THE LOOKBOOK <span class="lavee-hero-btn-arrow">→</span>
                </a>
                <a href="{{ routes.collections_url }}" class="lavee-hero-btn lavee-hero-btn--secondary">
                  <span class="lavee-hero-btn-icon">►</span> WATCH FULL FILM (2:45)
                </a>
              </div>
            </div>
          </div>
        {%- endif -%}
      </div>

      <!-- Bottom Bar Controls: Slide Counter, Nav Arrows, Line Progress, & Slide Selector Tabs -->
      {%- assign total_slides = section.blocks.size -%}
      {%- if total_slides == 0 -%}{%- assign total_slides = 4 -%}{%- endif -%}
      
      <div class="lavee-hero-controls-bottom">
        <!-- Left Side: Nav Arrows + Counter + Progress Bar -->
        <div class="lavee-hero-controls-left">
          <div class="lavee-hero-nav-btns">
            <button 
              type="button" 
              class="lavee-hero-nav-btn lavee-hero-nav-btn--prev" 
              aria-label="Previous Slide"
              onclick="prevLaveeHeroSlide('{{ section.id }}')"
            >
              ‹
            </button>
          </div>

          <div class="lavee-hero-counter">
            <span class="lavee-hero-counter__current" id="LaveeHeroCurrent-{{ section.id }}">01</span>
            <span class="lavee-hero-counter__divider">/</span>
            <span class="lavee-hero-counter__total">0{{ total_slides }}</span>
          </div>

          <div class="lavee-hero-nav-btns">
            <button 
              type="button" 
              class="lavee-hero-nav-btn lavee-hero-nav-btn--next" 
              aria-label="Next Slide"
              onclick="nextLaveeHeroSlide('{{ section.id }}')"
            >
              ›
            </button>
          </div>

          <!-- Line Progress Bar -->
          <div class="lavee-hero-progress-track">
            <div class="lavee-hero-progress-bar" id="LaveeHeroProgress-{{ section.id }}"></div>
          </div>
        </div>

        <!-- Right Side: Slide Selector Tabs (Pen.dev Design Spec) -->
        <div class="lavee-hero-tabs" id="LaveeHeroTabs-{{ section.id }}">
          {%- if section.blocks.size > 0 -%}
            {%- for block in section.blocks -%}
              <button 
                type="button"
                class="lavee-hero-tab-pill{% if forloop.first %} is-active{% endif %}"
                data-slide-target="{{ forloop.index0 }}"
                onclick="goToLaveeHeroSlide('{{ section.id }}', {{ forloop.index0 }})"
              >
                <span class="lavee-hero-tab-pill__icon">
                  {%- if block.settings.video != blank or block.settings.video_url != blank -%}
                    ►
                  {%- else -%}
                    📷
                  {%- endif -%}
                </span>
                <span class="lavee-hero-tab-pill__title">
                  {{ block.settings.tab_title | default: block.settings.heading | default: 'Slide' }}
                </span>
              </button>
            {%- endfor -%}
          {%- else -%}
            <!-- Fallback Pen.dev Design Tabs -->
            <button type="button" class="lavee-hero-tab-pill is-active" onclick="goToLaveeHeroSlide('{{ section.id }}', 0)">
              <span class="lavee-hero-tab-pill__icon">►</span>
              <span class="lavee-hero-tab-pill__title">01. Campaign Film</span>
            </button>
            <button type="button" class="lavee-hero-tab-pill" onclick="goToLaveeHeroSlide('{{ section.id }}', 1)">
              <span class="lavee-hero-tab-pill__icon">📷</span>
              <span class="lavee-hero-tab-pill__title">02. Silk Gowns</span>
            </button>
            <button type="button" class="lavee-hero-tab-pill" onclick="goToLaveeHeroSlide('{{ section.id }}', 2)">
              <span class="lavee-hero-tab-pill__icon">📷</span>
              <span class="lavee-hero-tab-pill__title">03. Atelier Craft</span>
            </button>
            <button type="button" class="lavee-hero-tab-pill" onclick="goToLaveeHeroSlide('{{ section.id }}', 3)">
              <span class="lavee-hero-tab-pill__icon">►</span>
              <span class="lavee-hero-tab-pill__title">04. Tailored Edit</span>
            </button>
          {%- endif -%}
        </div>
      </div>

    </div>
  </div>
</div>

<script>
  function toggleLaveeHeroAudio(btn) {
    const slider = btn.closest('.lavee-hero-wrapper');
    if (!slider) return;
    const videos = slider.querySelectorAll('video');
    if (!videos.length) return;
    
    const icon = btn.querySelector('.lavee-hero-audio-icon');
    const text = btn.querySelector('.lavee-hero-audio-text');
    const isMuted = videos[0].muted;
    
    videos.forEach(v => {
      v.muted = !isMuted;
    });
    
    if (isMuted) {
      if (icon) icon.textContent = '🔊';
      if (text) text.textContent = 'SOUND: ON | 4K CINEMATIC PRORES';
    } else {
      if (icon) icon.textContent = '🔇';
      if (text) text.textContent = 'SOUND: MUTE | 4K CINEMATIC PRORES';
    }
  }

  function initLaveeHeroSlider(sectionId) {
    const wrapper = document.querySelector(`[data-section-id="${sectionId}"]`);
    if (!wrapper) return;
    
    const track = wrapper.querySelector('#LaveeHeroTrack-' + sectionId);
    const slides = wrapper.querySelectorAll('.lavee-hero-slide');
    const counterCurrent = wrapper.querySelector('#LaveeHeroCurrent-' + sectionId);
    const progressBar = wrapper.querySelector('#LaveeHeroProgress-' + sectionId);
    const tabPills = wrapper.querySelectorAll('.lavee-hero-tab-pill');
    
    if (!slides.length) return;
    
    let currentIndex = 0;
    const totalSlides = slides.length;
    const isAutoplay = wrapper.dataset.autoplay === 'true';
    const speedSeconds = parseInt(wrapper.dataset.speed) || 5;
    let progressInterval = null;
    let progressPercent = 0;
    
    function updateSlide(index) {
      if (index < 0) index = totalSlides - 1;
      if (index >= totalSlides) index = 0;
      
      currentIndex = index;
      if (track) {
        track.style.transform = `translateX(-${currentIndex * 100}%)`;
      }
      
      slides.forEach((slide, idx) => {
        slide.classList.toggle('is-active', idx === currentIndex);
      });
      
      tabPills.forEach((pill, idx) => {
        pill.classList.toggle('is-active', idx === currentIndex);
      });
      
      if (counterCurrent) {
        counterCurrent.textContent = (currentIndex + 1 < 10 ? '0' : '') + (currentIndex + 1);
      }
      
      resetProgress();
    }
    
    function resetProgress() {
      if (progressInterval) clearInterval(progressInterval);
      progressPercent = 0;
      if (progressBar) progressBar.style.width = '0%';
      
      if (isAutoplay && totalSlides > 1) {
        const step = 100 / (speedSeconds * 20);
        progressInterval = setInterval(() => {
          progressPercent += step;
          if (progressBar) progressBar.style.width = Math.min(progressPercent, 100) + '%';
          if (progressPercent >= 100) {
            clearInterval(progressInterval);
            updateSlide(currentIndex + 1);
          }
        }, 50);
      }
    }
    
    window['prevLaveeHeroSlide_' + sectionId] = function() {
      updateSlide(currentIndex - 1);
    };
    
    window['nextLaveeHeroSlide_' + sectionId] = function() {
      updateSlide(currentIndex + 1);
    };

    window['goToLaveeHeroSlide_' + sectionId] = function(idx) {
      updateSlide(idx);
    };

    // Touch Swipe Support
    let touchStartX = 0;
    let touchEndX = 0;
    
    wrapper.addEventListener('touchstart', e => {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });
    
    wrapper.addEventListener('touchend', e => {
      touchEndX = e.changedTouches[0].screenX;
      if (touchStartX - touchEndX > 50) {
        updateSlide(currentIndex + 1);
      } else if (touchEndX - touchStartX > 50) {
        updateSlide(currentIndex - 1);
      }
    }, { passive: true });
    
    updateSlide(0);
  }

  function prevLaveeHeroSlide(id) {
    if (window['prevLaveeHeroSlide_' + id]) {
      window['prevLaveeHeroSlide_' + id]();
    }
  }

  function nextLaveeHeroSlide(id) {
    if (window['nextLaveeHeroSlide_' + id]) {
      window['nextLaveeHeroSlide_' + id]();
    }
  }

  function goToLaveeHeroSlide(id, index) {
    if (window['goToLaveeHeroSlide_' + id]) {
      window['goToLaveeHeroSlide_' + id](index);
    }
  }

  document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.lavee-hero-wrapper').forEach(wrapper => {
      const sectionId = wrapper.dataset.sectionId;
      if (sectionId) initLaveeHeroSlider(sectionId);
    });
  });

  document.addEventListener('shopify:section:load', function(e) {
    const wrapper = e.target.querySelector('.lavee-hero-wrapper');
    if (wrapper && wrapper.dataset.sectionId) {
      initLaveeHeroSlider(wrapper.dataset.sectionId);
    }
  });
</script>

{% schema %}
{
  "name": "La Vee Hero Slider",
  "tag": "section",
  "class": "lavee-hero-slider-section",
  "settings": [
    {
      "type": "header",
      "content": "Layout & Container Width"
    },
    {
      "type": "select",
      "id": "container_type",
      "label": "Section Width Type",
      "options": [
        { "value": "container-fluid", "label": "Container Fluid (Full Width - 100%)" },
        { "value": "container", "label": "Container (Fixed Width / Centered)" }
      ],
      "default": "container-fluid"
    },
    {
      "type": "select",
      "id": "section_height",
      "label": "Section Height Preset",
      "options": [
        { "value": "fullscreen", "label": "Full Screen (100vh)" },
        { "value": "large", "label": "Large (800px)" },
        { "value": "medium", "label": "Medium (650px)" }
      ],
      "default": "fullscreen"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Dark Overlay Opacity",
      "default": 40
    },
    {
      "type": "header",
      "content": "Live Badge & Audio Controls"
    },
    {
      "type": "checkbox",
      "id": "show_live_badge",
      "label": "Show Live Lookbook Badge",
      "default": true
    },
    {
      "type": "text",
      "id": "live_badge_text",
      "label": "Live Badge Content",
      "default": "VIDEO LOOKBOOK • AUTUMN/WINTER 2026"
    },
    {
      "type": "text",
      "id": "audio_btn_text",
      "label": "Audio Button Initial Text",
      "default": "SOUND: ON | 4K CINEMATIC PRORES"
    },
    {
      "type": "header",
      "content": "Autoplay & Timing"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable Slide Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Autoplay Duration",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Campaign Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Background Image"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Background Video (Shopify File)"
        },
        {
          "type": "text",
          "id": "video_url",
          "label": "External MP4 Video URL (Fallback)"
        },
        {
          "type": "text",
          "id": "tab_title",
          "label": "Bottom Slide Tab Label",
          "default": "01. Campaign Film"
        },
        {
          "type": "select",
          "id": "content_alignment",
          "label": "Content Box Alignment",
          "options": [
            { "value": "left", "label": "Left Aligned (Pen.dev Design)" },
            { "value": "center", "label": "Centered" }
          ],
          "default": "left"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow Tagline",
          "default": "LA VEE ATELIER — EXCLUSIVE CAMPAIGN"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Main Heading Title",
          "default": "Made to Be Remembered."
        },
        {
          "type": "textarea",
          "id": "subtext",
          "label": "Subtitle Description",
          "default": "Experience our Autumn/Winter 2026 Video Campaign. Sculpted silhouettes, liquid silks, and dramatic eveningwear crafted for iconic entrances."
        },
        {
          "type": "text",
          "id": "button_primary_label",
          "label": "Primary Button Label",
          "default": "SHOP THE LOOKBOOK"
        },
        {
          "type": "url",
          "id": "button_primary_link",
          "label": "Primary Button Link"
        },
        {
          "type": "text",
          "id": "button_secondary_label",
          "label": "Secondary Button Label",
          "default": "WATCH FULL FILM (2:45)"
        },
        {
          "type": "url",
          "id": "button_secondary_link",
          "label": "Secondary Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "La Vee Hero Slider",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "tab_title": "01. Campaign Film",
            "content_alignment": "left",
            "eyebrow": "LA VEE ATELIER — EXCLUSIVE CAMPAIGN",
            "heading": "Made to Be Remembered.",
            "subtext": "Experience our Autumn/Winter 2026 Video Campaign. Sculpted silhouettes, liquid silks, and dramatic eveningwear crafted for iconic entrances.",
            "button_primary_label": "SHOP THE LOOKBOOK",
            "button_secondary_label": "WATCH FULL FILM (2:45)"
          }
        },
        {
          "type": "slide",
          "settings": {
            "tab_title": "02. Silk Gowns",
            "content_alignment": "left",
            "eyebrow": "AUTUMN/WINTER COUTURE 2026",
