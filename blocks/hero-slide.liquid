{% doc %}
  @name Hero Slide
  @description Individual slide for the Hero Media Slider section supporting image or video background.
{% enddoc %}

<div class="hero-slide relative overflow-hidden flex items-center justify-center min-h-[500px] lg:min-h-[760px] w-full" {{ block.shopify_attributes }}>
  {%- if block.settings.video != blank -%}
    <div class="hero-slide__media absolute inset-0 w-full h-full">
      {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, class: 'w-full h-full object-cover' }}
    </div>
  {%- elsif block.settings.image != blank -%}
    <div class="hero-slide__media absolute inset-0 w-full h-full">
      <img
        src="{{ block.settings.image | image_url: width: 2000 }}"
        alt="{{ block.settings.heading | escape }}"
        loading="lazy"
        class="w-full h-full object-cover"
        width="2000"
        height="1000"
      >
    </div>
  {%- else -%}
    <div class="hero-slide__media absolute inset-0 w-full h-full bg-[#3E151A]"></div>
  {%- endif -%}

  <div class="hero-slide__overlay absolute inset-0 bg-black/30 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>

  <div class="hero-slide__content relative z-10 text-center text-white px-6 max-w-4xl mx-auto py-20 flex flex-col items-center">
    {%- if block.settings.eyebrow != blank -%}
      <span class="hero-slide__eyebrow uppercase tracking-[0.2em] text-xs md:text-sm font-semibold mb-4 text-[#EDE6DC]">
        {{ block.settings.eyebrow | escape }}
      </span>
    {%- endif -%}

    {%- if block.settings.heading != blank -%}
      <h2 class="hero-slide__heading font-serif text-3xl md:text-5xl lg:text-7xl font-normal leading-tight mb-6">
        {{ block.settings.heading | escape }}
      </h2>
    {%- endif -%}

    {%- if block.settings.subtext != blank -%}
      <p class="hero-slide__subtext text-sm md:text-base lg:text-lg text-[#F7F4EF]/90 max-w-2xl mb-8 leading-relaxed">
        {{ block.settings.subtext | escape }}
      </p>
    {%- endif -%}

    {%- if block.settings.button_label != blank -%}
      <a
        href="{{ block.settings.button_link | default: '#' }}"
        class="hero-slide__button inline-block bg-[#161616] hover:bg-[#333333] text-white px-8 py-4 text-xs md:text-sm font-semibold uppercase tracking-widest transition-all duration-200"
      >
        {{ block.settings.button_label | escape }}
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Hero Slide",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Slide Image"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Background Video"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "AUTUMN/WINTER COUTURE 2026"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Timeless Elegance & Sculpted Luxury"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "Discover bespoke corsetry, hand-beaded gowns, and tailored couture silhouettes."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "EXPLORE THE COLLECTION"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ]
}
{% endschema %}
