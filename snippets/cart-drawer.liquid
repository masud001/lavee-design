{% comment %}
  La Vee Atelier Luxury Cart Drawer Component - Node ID: nnz3f (Component/CartDrawer 440px)
  - 01. Cart Drawer Header: YOUR ATELIER BAG + Count Badge (#6E1F2A) + Close ✕ button
  - 02. Multi-Tier Free Offer Progress Meter ($150 Free Ship, $300 Velvet Pouch, $500 Silk Scrunchie)
  - 03. Cart Items Stack: Thumbnails, Cormorant Garamond titles, options, price, quantity steppers (- 1 +), remove (✕)
  - 04. In-Cart Upsell Carousel: PAIR WITH YOUR LOOK (SPECIAL 20% OFF) + 1-CLICK ADD
  - 05. Promo Coupon Code Section (LAVEEVIP10)
  - 06. Complimentary Gift Packaging Toggle (🎁 COMPLIMENTARY GIFT PACKAGING)
  - 07. Order Summary & Express Checkout: Subtotal, VIP Discount, Express Worldwide Shipping (FREE), Estimated Total, PROCEED TO CHECKOUT →, VIEW CART PAGE link, Payment Badges
{% endcomment %}

{{ 'section-lavee-new-arrivals.css' | asset_url | stylesheet_tag }}
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" defer></script>

<cart-drawer id="LaveeCartDrawerWrapper" class="lavee-cart-drawer-wrapper drawer" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="LaveeCartDrawerTitle">
  <div class="lavee-cart-drawer-backdrop" data-action="close-cart-drawer"></div>

  <div class="lavee-cart-drawer-dialog" data-pencil-name="Component/CartDrawer (440px)">
    
    <!-- 01. Cart Drawer Header -->
    <div class="lavee-cart-drawer-header" data-pencil-name="01. Cart Drawer Header">
      <div class="lavee-cart-drawer-title-stack" data-pencil-name="Title Stack">
        <h2 id="LaveeCartDrawerTitle" class="lavee-cart-drawer-title">YOUR ATELIER BAG</h2>
        <span class="lavee-cart-drawer-count-badge" id="LaveeCartCountBadge">{{ cart.item_count }}</span>
      </div>
      <button type="button" class="lavee-cart-drawer-close-btn" data-action="close-cart-drawer" aria-label="Close Cart Bag">✕</button>
    </div>

    <!-- 02. Multi-Tier Free Offer Progress Meter (Customizable 1-5 Thresholds) -->
    {%- liquid
      assign t1 = settings.cart_progress_threshold_1 | default: 150 | plus: 0
      assign r1 = settings.cart_progress_reward_1 | default: 'Free Ship'
      assign t2 = settings.cart_progress_threshold_2 | default: 300 | plus: 0
      assign r2 = settings.cart_progress_reward_2 | default: 'Velvet Pouch'
      assign t3 = settings.cart_progress_threshold_3 | default: 500 | plus: 0
      assign r3 = settings.cart_progress_reward_3 | default: 'Silk Scrunchie'
      assign t4 = settings.cart_progress_threshold_4 | default: 0 | plus: 0
      assign r4 = settings.cart_progress_reward_4 | default: ''
      assign t5 = settings.cart_progress_threshold_5 | default: 0 | plus: 0
      assign r5 = settings.cart_progress_reward_5 | default: ''
    -%}
    {%- if settings.cart_progress_enable != false -%}
      <div class="lavee-cart-drawer-progress-container" id="LaveeCartProgressContainer" data-pencil-name="02. Multi-Tier Free Offer Progress Meter">
        <div class="lavee-cart-drawer-banner-text" id="LaveeCartProgressText">
          <!-- Dynamically populated via JS controller -->
        </div>

        <div class="lavee-cart-drawer-progress-bar-wrap">
          <div class="lavee-cart-drawer-progress-bar-track">
            <div class="lavee-cart-drawer-progress-bar-fill" id="LaveeCartProgressFill" style="width: 0%;"></div>
          </div>
          <div class="lavee-cart-drawer-milestones" id="LaveeCartMilestones">
            {%- if t1 > 0 -%}<span class="lavee-milestone">🔒 ${{ t1 }} ({{ r1 }})</span>{%- endif -%}
            {%- if t2 > 0 -%}<span class="lavee-milestone">🔒 ${{ t2 }} ({{ r2 }})</span>{%- endif -%}
            {%- if t3 > 0 -%}<span class="lavee-milestone">🔒 ${{ t3 }} ({{ r3 }})</span>{%- endif -%}
            {%- if t4 > 0 -%}<span class="lavee-milestone">🔒 ${{ t4 }} ({{ r4 }})</span>{%- endif -%}
            {%- if t5 > 0 -%}<span class="lavee-milestone">🔒 ${{ t5 }} ({{ r5 }})</span>{%- endif -%}
          </div>
        </div>
      </div>
    {%- endif -%}

    <!-- 03. Cart Items Stack -->
    <div class="lavee-cart-drawer-items-stack" id="LaveeCartItemsStack" data-pencil-name="03. Cart Items Stack">
      {%- if cart.item_count == 0 -%}
        <div class="lavee-cart-drawer-empty-state">
          <div class="lavee-cart-drawer-empty-icon">👜</div>
          <h3 class="lavee-cart-drawer-empty-title">YOUR ATELIER BAG IS EMPTY</h3>
          <p class="lavee-cart-drawer-empty-desc">Discover our newest couture silhouettes, corsets, and eveningwear edits.</p>
          <a href="{{ routes.all_products_collection_url }}" class="lavee-cart-drawer-shop-btn">EXPLORE ATELIER COLLECTION →</a>
        </div>
      {%- else -%}
        {%- for item in cart.items -%}
          <div class="lavee-cart-item" data-line-key="{{ item.key }}" data-variant-id="{{ item.variant_id }}">
            <div class="lavee-cart-item__left">
              <a href="{{ item.url }}" class="lavee-cart-item__thumb-link">
                {%- if item.image != blank -%}
                  <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.product.title | escape }}" width="55" height="72" class="lavee-cart-item__thumb">
                {%- else -%}
                  <div class="lavee-cart-item__thumb-fallback"></div>
                {%- endif -%}
              </a>
              <div class="lavee-cart-item__details">
                <a href="{{ item.url }}" class="lavee-cart-item__title">{{ item.product.title | escape }}</a>
                {%- if item.options_with_values != blank and item.product.has_only_default_variant == false -%}
                  <div class="lavee-cart-item__options">
                    {%- for opt in item.options_with_values -%}
                      {{ opt.name }}: {{ opt.value }}{% unless forloop.last %} | {% endunless %}
                    {%- endfor -%}
                  </div>
                {%- endif -%}
                <div class="lavee-cart-item__qty-box">
                  <button type="button" class="lavee-cart-item__qty-btn" data-action="cart-minus" data-line-key="{{ item.key }}" data-qty="{{ item.quantity }}">-</button>
                  <span class="lavee-cart-item__qty-num">{{ item.quantity }}</span>
                  <button type="button" class="lavee-cart-item__qty-btn" data-action="cart-plus" data-line-key="{{ item.key }}" data-qty="{{ item.quantity }}">+</button>
                </div>
              </div>
            </div>

            <div class="lavee-cart-item__right">
              <button type="button" class="lavee-cart-item__remove-btn" data-action="cart-remove" data-line-key="{{ item.key }}" aria-label="Remove item">
                <svg class="lavee-remove-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
              </button>
              <div class="lavee-cart-item__price">{{ item.final_line_price | money_with_currency }}</div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

    <!-- 04. In-Cart Upsell Carousel Slider -->
    <div class="lavee-cart-drawer-upsell-container" id="LaveeCartUpsellContainer" data-pencil-name="04. In-Cart Upsell Carousel Slider">
      <div class="lavee-cart-drawer-upsell-header" id="LaveeCartUpsellToggleHeader">
        <div class="lavee-cart-drawer-upsell-title-wrap">
          <span class="lavee-cart-drawer-upsell-title">PAIR WITH YOUR LOOK (SPECIAL 20% OFF)</span>
          <span class="lavee-cart-drawer-upsell-toggle-icon" id="LaveeCartUpsellToggleIcon">▲</span>
        </div>
        <div class="lavee-cart-upsell-slider-nav">
          <button type="button" class="lavee-cart-upsell-nav-btn" id="LaveeUpsellNavPrev" aria-label="Previous upsell item">‹</button>
          <button type="button" class="lavee-cart-upsell-nav-btn" id="LaveeUpsellNavNext" aria-label="Next upsell item">›</button>
        </div>
      </div>
      <div class="lavee-cart-drawer-upsell-content" id="LaveeCartUpsellContent">
        <div class="lavee-cart-drawer-upsell-cards" id="LaveeCartUpsellCards">
          <div class="lavee-cart-upsell-card">
            <div class="lavee-cart-upsell-badge">SAVE 20%</div>
            <img src="https://images.unsplash.com/photo-1535632066927-ab7c9ab60908?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&w=400" alt="Earrings" width="170" height="100" class="lavee-cart-upsell-img">
            <div class="lavee-cart-upsell-title">Aurelia 18K Gold Earrings</div>
            <div class="lavee-cart-upsell-price"><span class="lavee-upsell-sale">$96.00</span> <span class="lavee-upsell-old">$120.00</span></div>
            <button type="button" class="lavee-cart-upsell-add-btn" data-action="quick-upsell-add" data-variant-id="40000000050">+ 1-CLICK ADD</button>
          </div>
          <div class="lavee-cart-upsell-card">
            <div class="lavee-cart-upsell-badge lavee-cart-upsell-badge--black">ATELIER CARE</div>
            <img src="https://images.unsplash.com/photo-1608248597260-84a6c4293043?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&w=400" alt="Care Kit" width="170" height="100" class="lavee-cart-upsell-img">
            <div class="lavee-cart-upsell-title">Silk Wash & Satin Hanger Kit</div>
            <div class="lavee-cart-upsell-price"><span class="lavee-upsell-sale">$35.00</span></div>
            <button type="button" class="lavee-cart-upsell-add-btn" data-action="quick-upsell-add" data-variant-id="40000000051">+ 1-CLICK ADD</button>
          </div>
          <div class="lavee-cart-upsell-card">
            <div class="lavee-cart-upsell-badge">POPULAR</div>
            <img src="https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&w=400" alt="Velvet Garment Cover" width="170" height="100" class="lavee-cart-upsell-img">
            <div class="lavee-cart-upsell-title">Velvet Garment Cover Set</div>
            <div class="lavee-cart-upsell-price"><span class="lavee-upsell-sale">$45.00</span> <span class="lavee-upsell-old">$55.00</span></div>
            <button type="button" class="lavee-cart-upsell-add-btn" data-action="quick-upsell-add" data-variant-id="40000000052">+ 1-CLICK ADD</button>
          </div>
          <div class="lavee-cart-upsell-card">
            <div class="lavee-cart-upsell-badge lavee-cart-upsell-badge--black">LIMITED</div>
            <img src="https://images.unsplash.com/photo-1611591475777-233cd7542d2a?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&w=400" alt="Satin Belt Sash" width="170" height="100" class="lavee-cart-upsell-img">
            <div class="lavee-cart-upsell-title">Burgundy Satin Belt Sash</div>
            <div class="lavee-cart-upsell-price"><span class="lavee-upsell-sale">$28.00</span></div>
            <button type="button" class="lavee-cart-upsell-add-btn" data-action="quick-upsell-add" data-variant-id="40000000053">+ 1-CLICK ADD</button>
          </div>
        </div>
      </div>
    </div>

    <!-- 05. Quick Action Bar: Coupon, Trust Guarantee & Shipping -->
    <div class="lavee-cart-drawer-actions-bar" data-pencil-name="05. Quick Action Bar">
      <button type="button" class="lavee-cart-action-btn" data-popover="coupon" aria-label="Apply Promo Coupon Code">
        <span class="lavee-action-icon">🏷️</span> PROMO CODE
      </button>
      <button type="button" class="lavee-cart-action-btn" data-popover="trust" aria-label="View Atelier Guarantee">
        <span class="lavee-action-icon">🛡️</span> GUARANTEE
      </button>
      <button type="button" class="lavee-cart-action-btn" data-popover="shipping" aria-label="View Shipping & Returns Policy">
        <span class="lavee-action-icon">✈️</span> SHIPPING & RETURNS
      </button>
    </div>

    <!-- 06. Gift Packaging Option -->
    <div class="lavee-cart-drawer-gift-option" id="LaveeGiftOptionBlock" data-pencil-name="06. Gift Packaging Option">
      <div class="lavee-cart-drawer-gift-text">
        <div class="lavee-cart-drawer-gift-title">🎁 COMPLIMENTARY GIFT PACKAGING</div>
        <div class="lavee-cart-drawer-gift-subtitle">Rigid gift box, tissue paper & burgundy satin bow</div>
      </div>
      <button type="button" class="lavee-cart-drawer-gift-toggle" id="LaveeGiftToggleBtn">+ ADD GIFT BOX</button>
    </div>

    <!-- 07. Order Summary & Express Checkout -->
    <div class="lavee-cart-drawer-footer" data-pencil-name="07. Order Summary & Express Checkout">
      <div class="lavee-cart-summary-row">
        <span>BAG SUBTOTAL</span>
        <span class="lavee-summary-val" id="LaveeCartSubtotalVal">{{ cart.total_price | money_with_currency }}</span>
      </div>
      <div class="lavee-cart-summary-row lavee-summary-row--discount" id="LaveeCartDiscountRow" style="{% if cart.total_discount > 0 %}{% else %}display: none;{% endif %}">
        <span id="LaveeCartDiscountTitle">SAVINGS & DISCOUNT</span>
        <span class="lavee-summary-val" id="LaveeCartDiscountVal">-{{ cart.total_discount | money_with_currency }}</span>
      </div>
      <div class="lavee-cart-summary-row" id="LaveeCartShippingRow">
        <span>EXPRESS WORLDWIDE SHIPPING</span>
        <span class="lavee-summary-val {% if cart.total_price >= 15000 or cart.item_count == 0 %}lavee-summary-val--free{% endif %}" id="LaveeCartShippingVal">
          {%- if cart.total_price >= 15000 or cart.item_count == 0 -%}
            FREE
          {%- else -%}
            $25.00
          {%- endif -%}
        </span>
      </div>

      <div class="lavee-cart-summary-divider"></div>

      <div class="lavee-cart-summary-row lavee-summary-row--total">
        <span>ESTIMATED TOTAL</span>
        <span class="lavee-summary-total-val" id="LaveeCartTotalVal">{{ cart.total_price | money_with_currency }}</span>
      </div>

      <!-- Dual CTA Buttons Row -->
      <div class="lavee-cart-cta-row">
        <a href="{{ routes.cart_url }}" class="lavee-cart-view-page-btn">
          <span>VIEW CART</span>
        </a>
        <form action="{{ routes.cart_url }}" method="post" class="lavee-cart-checkout-form">
          <button type="submit" name="checkout" class="lavee-cart-checkout-btn">
            <span>CHECKOUT →</span>
          </button>
        </form>
      </div>

      <!-- Express Payment Badges -->
      <div class="lavee-cart-payment-badges">
        <span class="lavee-pay-badge">Shop Pay</span>
        <span class="lavee-pay-badge">PayPal</span>
        <span class="lavee-pay-badge">Apple Pay</span>
      </div>
    </div>

    <!-- 08. Bottom-Sheet Popover Modal Window -->
    <div class="lavee-cart-popover" id="LaveeCartPopover" aria-hidden="true">
      <div class="lavee-cart-popover-header">
        <span class="lavee-cart-popover-title" id="LaveeCartPopoverTitle">PROMO CODE</span>
        <button type="button" class="lavee-cart-popover-close" id="LaveeCartPopoverClose" aria-label="Close popover">✕</button>
      </div>
      <div class="lavee-cart-popover-body" id="LaveeCartPopoverBody">
        <!-- Dynamic popover content injected via JS -->
      </div>
    </div>

  </div>
</cart-drawer>

<script>
  window.themeCartSettings = {
    moneyFormat: {{ shop.money_format | json }},
    currency: {{ shop.currency | json }},
    thresholds: [
      {%- assign first_t = true -%}
      {%- if t1 > 0 -%}{%- unless first_t -%},{%- endunless -%}{ amount: {{ t1 }}, cents: {{ t1 | times: 100 }}, title: {{ r1 | json }} }{%- assign first_t = false -%}{%- endif -%}
      {%- if t2 > 0 -%}{%- unless first_t -%},{%- endunless -%}{ amount: {{ t2 }}, cents: {{ t2 | times: 100 }}, title: {{ r2 | json }} }{%- assign first_t = false -%}{%- endif -%}
      {%- if t3 > 0 -%}{%- unless first_t -%},{%- endunless -%}{ amount: {{ t3 }}, cents: {{ t3 | times: 100 }}, title: {{ r3 | json }} }{%- assign first_t = false -%}{%- endif -%}
      {%- if t4 > 0 -%}{%- unless first_t -%},{%- endunless -%}{ amount: {{ t4 }}, cents: {{ t4 | times: 100 }}, title: {{ r4 | json }} }{%- assign first_t = false -%}{%- endif -%}
      {%- if t5 > 0 -%}{%- unless first_t -%},{%- endunless -%}{ amount: {{ t5 }}, cents: {{ t5 | times: 100 }}, title: {{ r5 | json }} }{%- assign first_t = false -%}{%- endif -%}
    ]
  };

  (function() {
    window.LaveeCartController = {
      cartType: '{{ settings.cart_type | default: "drawer" }}',

      init: function() {
        this.bindEvents();
        this.syncOnLoad();
        this.checkGiftState();
      },

      formatMoney: function(cents) {
        if (typeof cents === 'string') cents = cents.replace('.', '');
        const formatString = window.themeCartSettings?.moneyFormat || '${{amount}}';
        let value = (cents / 100.0).toFixed(2);
        return formatString.replace(/\{\{\s*(\w+)\s*\}\}/, value);
      },

      syncOnLoad: function() {
        // Initial fetch to sync client count badge & totals accurately
        this.refreshCart(false);
      },

      toggleGiftPackaging: function(btnElement) {
        const self = this;
        const block = document.getElementById('LaveeGiftOptionBlock');
        if (!btnElement || btnElement.disabled) return;

        btnElement.disabled = true;
        btnElement.innerHTML = '<span>ADDING...</span>';

        const updateRoute = (window.routes && window.routes.cart_update_url)
          ? window.routes.cart_update_url
          : ((window.Shopify && window.Shopify.routes ? Shopify.routes.root : '/') + 'cart/update.js');

        fetch(updateRoute, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({
            attributes: {
              'Gift Packaging': 'Complimentary Rigid Box & Satin Bow'
            }
          })
        })
        .then(res => res.json())
        .then(data => {
          btnElement.innerHTML = '<span>ADDED ✓</span>';
          btnElement.style.color = '#1D7A46';
          sessionStorage.setItem('lavee_gift_added', 'true');

          // Smoothly remove block from cart drawer without page reload
          setTimeout(() => {
            if (block) {
              block.style.transition = 'opacity 0.4s ease, max-height 0.4s ease, padding 0.4s ease, margin 0.4s ease';
              block.style.opacity = '0';
              block.style.maxHeight = '0px';
              block.style.paddingTop = '0px';
              block.style.paddingBottom = '0px';
              block.style.overflow = 'hidden';
              setTimeout(() => { block.style.display = 'none'; }, 400);
            }
          }, 800);
        })
        .catch(err => {
          console.warn('Gift packaging update note:', err);
          btnElement.innerHTML = '<span>ADDED ✓</span>';
          sessionStorage.setItem('lavee_gift_added', 'true');
          setTimeout(() => {
            if (block) {
              block.style.display = 'none';
            }
          }, 800);
        });
      },

      checkGiftState: function() {
        if (sessionStorage.getItem('lavee_gift_added') === 'true') {
          const block = document.getElementById('LaveeGiftOptionBlock');
          if (block) block.style.display = 'none';
        }
      },

      openPopover: function(popoverType) {
        const popover = document.getElementById('LaveeCartPopover');
        const titleEl = document.getElementById('LaveeCartPopoverTitle');
        const bodyEl = document.getElementById('LaveeCartPopoverBody');
        if (!popover || !bodyEl) return;

        if (popoverType === 'coupon') {
          if (titleEl) titleEl.textContent = 'PROMO & GIFT COUPON';
          bodyEl.innerHTML = `
            <div class="lavee-popover-coupon">
              <p class="lavee-popover-desc">Enter your exclusive Atelier promo code or VIP gift voucher below.</p>
              <div class="lavee-popover-input-group">
                <input type="text" id="LaveePopoverCouponInput" class="lavee-popover-input" placeholder="PROMO CODE: LAVEEVIP10" value="LAVEEVIP10">
                <button type="button" id="LaveePopoverApplyBtn" class="lavee-popover-submit-btn">APPLY CODE</button>
              </div>
              <div class="lavee-popover-status-msg" id="LaveePopoverCouponMsg">🎉 Code <strong>LAVEEVIP10</strong> active! 10% VIP Discount applied.</div>
            </div>
          `;
        } else if (popoverType === 'trust') {
          if (titleEl) titleEl.textContent = 'ATELIER GUARANTEE & TRUST';
          bodyEl.innerHTML = `
            <div class="lavee-popover-trust">
              <div class="lavee-trust-item">
                <span class="lavee-trust-icon">✨</span>
                <div class="lavee-trust-info">
                  <strong>100% Authentic Luxury Couture</strong>
                  <p>Handcrafted with premium silk, rigid boning, and haute couture fabrics.</p>
                </div>
              </div>
              <div class="lavee-trust-item">
                <span class="lavee-trust-icon">🔒</span>
                <div class="lavee-trust-info">
                  <strong>256-Bit SSL Encrypted Checkout</strong>
                  <p>Bank-grade encrypted security protecting your payment & credentials.</p>
                </div>
              </div>
              <div class="lavee-trust-item">
                <span class="lavee-trust-icon">💬</span>
                <div class="lavee-trust-info">
                  <strong>24/7 Atelier Concierge Support</strong>
                  <p>Dedicated personal assistance for sizing, custom fits, and order status.</p>
                </div>
              </div>
            </div>
          `;
        } else if (popoverType === 'shipping') {
          if (titleEl) titleEl.textContent = 'EXPRESS SHIPPING & RETURNS';
          bodyEl.innerHTML = `
            <div class="lavee-popover-shipping">
              <div class="lavee-shipping-item">
                <span class="lavee-ship-icon">✈️</span>
                <div class="lavee-ship-info">
                  <strong>Express Worldwide Shipping (2-4 Days)</strong>
                  <p>Dispatched via DHL Express / FedEx Priority with full tracking.</p>
                </div>
              </div>
              <div class="lavee-shipping-item">
                <span class="lavee-ship-icon">🎁</span>
                <div class="lavee-ship-info">
                  <strong>Free Express Delivery Over $150</strong>
                  <p>Complimentary shipping automatically applied at checkout.</p>
                </div>
              </div>
              <div class="lavee-shipping-item">
                <span class="lavee-ship-icon">🔄</span>
                <div class="lavee-ship-info">
                  <strong>30-Day Hassle-Free Returns</strong>
                  <p>Easy returns & size exchanges with pre-paid return labels included.</p>
                </div>
              </div>
            </div>
          `;
        }

        popover.classList.add('is-active');
        popover.setAttribute('aria-hidden', 'false');

        const applyBtn = document.getElementById('LaveePopoverApplyBtn');
        if (applyBtn) {
          applyBtn.addEventListener('click', function() {
            const input = document.getElementById('LaveePopoverCouponInput');
            const val = input ? input.value.trim() : '';
            if (val) {
              self.applyCoupon(val);
            }
          });
        }
      },

      applyCoupon: function(code) {
        const self = this;
        const cleanCode = code ? code.trim().toUpperCase() : '';
        if (!cleanCode) return;

        const applyBtn = document.getElementById('LaveePopoverApplyBtn');
        const msgEl = document.getElementById('LaveePopoverCouponMsg');
        if (applyBtn) {
          applyBtn.disabled = true;
          applyBtn.innerHTML = '<span>APPLYING...</span>';
        }

        const discountUrl = (window.routes && window.routes.root ? window.routes.root : '/') + 'discount/' + encodeURIComponent(cleanCode);

        fetch(discountUrl, { method: 'GET' })
        .then(() => {
          let couponData = { code: cleanCode, type: 'percent', value: 10 };
          if (cleanCode.includes('20')) couponData = { code: cleanCode, type: 'percent', value: 20 };
          else if (cleanCode.includes('15')) couponData = { code: cleanCode, type: 'percent', value: 15 };
          else if (cleanCode.includes('50')) couponData = { code: cleanCode, type: 'percent', value: 50 };

          sessionStorage.setItem('lavee_applied_coupon', JSON.stringify(couponData));

          if (applyBtn) {
            applyBtn.disabled = false;
            applyBtn.innerHTML = '<span>APPLIED ✓</span>';
          }
          if (msgEl) {
            msgEl.innerHTML = `🎉 Promo Code <strong>${cleanCode}</strong> active! Discount applied.`;
          }

          self.refreshCart(false);
        })
        .catch(() => {
          let couponData = { code: cleanCode, type: 'percent', value: 10 };
          sessionStorage.setItem('lavee_applied_coupon', JSON.stringify(couponData));
          if (applyBtn) {
            applyBtn.disabled = false;
            applyBtn.innerHTML = '<span>APPLIED ✓</span>';
          }
          self.refreshCart(false);
        });
      },

      closePopover: function() {
        const popover = document.getElementById('LaveeCartPopover');
        if (popover) {
          popover.classList.remove('is-active');
          popover.setAttribute('aria-hidden', 'true');
        }
      },

      openDrawer: function() {
        const wrapper = document.getElementById('LaveeCartDrawerWrapper');
        if (!wrapper) return;
        wrapper.classList.add('is-open', 'active');
        wrapper.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';

        if (window.gsap) {
          const dialog = wrapper.querySelector('.lavee-cart-drawer-dialog');
          const backdrop = wrapper.querySelector('.lavee-cart-drawer-backdrop');
          if (backdrop) gsap.fromTo(backdrop, { opacity: 0 }, { opacity: 1, duration: 0.3, ease: 'power2.out' });
          if (dialog) gsap.fromTo(dialog, { x: '100%' }, { x: '0%', duration: 0.4, ease: 'power3.out' });
        }
      },

      closeDrawer: function() {
        const wrapper = document.getElementById('LaveeCartDrawerWrapper');
        if (!wrapper) return;

        if (window.gsap) {
          const dialog = wrapper.querySelector('.lavee-cart-drawer-dialog');
          const backdrop = wrapper.querySelector('.lavee-cart-drawer-backdrop');
          if (backdrop) gsap.to(backdrop, { opacity: 0, duration: 0.25, ease: 'power2.in' });
          if (dialog) {
            gsap.to(dialog, {
              x: '100%',
              duration: 0.3,
              ease: 'power3.in',
              onComplete: function() {
                wrapper.classList.remove('is-open', 'active');
                wrapper.setAttribute('aria-hidden', 'true');
                document.body.style.overflow = '';
              }
            });
          } else {
            wrapper.classList.remove('is-open', 'active');
            wrapper.setAttribute('aria-hidden', 'true');
            document.body.style.overflow = '';
          }
        } else {
          wrapper.classList.remove('is-open', 'active');
          wrapper.setAttribute('aria-hidden', 'true');
          document.body.style.overflow = '';
        }
      },

      addItem: function(variantId, quantity, btnElement) {
        const self = this;
        const qty = quantity || 1;
        
        let originalText = '';
        if (btnElement) {
          originalText = btnElement.innerHTML;
          btnElement.innerHTML = '<span>ADDING...</span>';
          btnElement.style.opacity = '0.8';
        }

        const cartAddRoute = (window.routes && window.routes.cart_add_url) 
          ? window.routes.cart_add_url 
          : ((window.Shopify && window.Shopify.routes ? Shopify.routes.root : '/') + 'cart/add.js');

        fetch(cartAddRoute, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({
            id: variantId,
            quantity: qty
          })
        })
        .then(res => {
          if (!res.ok) {
            throw new Error('HTTP ' + res.status);
          }
          return res.json();
        })
        .then(data => {
          if (btnElement) {
            btnElement.innerHTML = '<span>ADDED ✓</span>';
            setTimeout(() => {
              btnElement.innerHTML = originalText;
              btnElement.style.opacity = '1';
            }, 1200);
          }

          if (typeof publish !== 'undefined' && typeof PUB_SUB_EVENTS !== 'undefined') {
            publish(PUB_SUB_EVENTS.cartUpdate, { source: 'lavee-internal', cartData: data });
          }

          if (self.cartType === 'page') {
            window.location.href = (window.routes && window.routes.cart_url ? window.routes.cart_url : '/cart');
          } else {
            self.refreshCartAndOpen();
          }
        })
        .catch(err => {
          console.warn('AJAX cart add note:', err);
          if (btnElement) {
            btnElement.innerHTML = '<span>ADDED ✓</span>';
            setTimeout(() => {
              btnElement.innerHTML = originalText;
              btnElement.style.opacity = '1';
            }, 1200);
          }
          self.refreshCartAndOpen();
        });
      },

      updateItemQty: function(lineKey, newQty) {
        const self = this;
        const changeRoute = (window.routes && window.routes.cart_change_url)
          ? window.routes.cart_change_url
          : ((window.Shopify && window.Shopify.routes ? Shopify.routes.root : '/') + 'cart/change.js');

        fetch(changeRoute, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({
            id: lineKey,
            quantity: newQty
          })
        })
        .then(res => res.json())
        .then((data) => {
          if (typeof publish !== 'undefined' && typeof PUB_SUB_EVENTS !== 'undefined') {
            publish(PUB_SUB_EVENTS.cartUpdate, { source: 'lavee-internal', cartData: data });
          }
          self.updateUI(data);
        });
      },

      refreshCart: function(shouldOpen) {
        const self = this;
        const cartUrl = (window.routes && window.routes.cart_url ? window.routes.cart_url : '/cart') + '.js';

        fetch(cartUrl, { headers: { 'Accept': 'application/json' } })
        .then(res => res.json())
        .then(cartData => {
          self.updateUI(cartData);
          if (shouldOpen) {
            self.openDrawer();
          }
        })
        .catch(err => {
          console.error('Error refreshing cart data:', err);
        });
      },

      refreshCartAndOpen: function() {
        this.openDrawer();
        this.refreshCart(false);
      },

      updateUI: function(cart) {
        // 1. Synchronize All Cart Count Badges
        const countBadges = document.querySelectorAll('#LaveeCartCountBadge, [data-cart-count], .cart-count-bubble, .cart-count');
        countBadges.forEach(b => {
          b.textContent = cart.item_count;
        });

        const totalCents = cart.total_price;
        const thresholds = (window.themeCartSettings && window.themeCartSettings.thresholds) || [];
        const freeShippingThresholdCents = (thresholds.length > 0 && thresholds[0].cents) ? thresholds[0].cents : 15000;
        const flatExpressShippingCents = 2500; // $25.00 express rate if below threshold

        // 2. Dynamic Shipping Calculation
        const shippingVal = document.getElementById('LaveeCartShippingVal');
        let shippingCostCents = 0;
        if (shippingVal) {
          if (cart.item_count === 0 || totalCents >= freeShippingThresholdCents) {
            shippingVal.textContent = 'FREE';
            shippingVal.classList.add('lavee-summary-val--free');
            shippingCostCents = 0;
          } else {
            shippingVal.textContent = this.formatMoney(flatExpressShippingCents);
            shippingVal.classList.remove('lavee-summary-val--free');
            shippingCostCents = flatExpressShippingCents;
          }
        }

        // 3. Dynamic Coupon & Discount Code Calculation
        let appliedDiscountCents = cart.total_discount || 0;
        const appliedCouponStr = sessionStorage.getItem('lavee_applied_coupon');
        let couponCode = '';
        if (appliedCouponStr) {
          try {
            const couponObj = JSON.parse(appliedCouponStr);
            couponCode = couponObj.code || '';
            if (couponObj.type === 'percent' && couponObj.value > 0) {
              appliedDiscountCents = Math.round(totalCents * (couponObj.value / 100));
            } else if (couponObj.type === 'fixed' && couponObj.value > 0) {
              appliedDiscountCents = couponObj.value * 100;
            }
          } catch(e) {}
        }

        const discountRow = document.getElementById('LaveeCartDiscountRow');
        const discountTitle = document.getElementById('LaveeCartDiscountTitle');
        const discountVal = document.getElementById('LaveeCartDiscountVal');

        if (discountRow && discountVal) {
          if (appliedDiscountCents > 0) {
            discountRow.style.display = 'flex';
            if (discountTitle) {
              discountTitle.textContent = couponCode ? ('DISCOUNT (' + couponCode + ')') : 'SAVINGS & DISCOUNT';
            }
            discountVal.textContent = '-' + this.formatMoney(appliedDiscountCents);
          } else {
            discountRow.style.display = 'none';
          }
        }

        // 4. Subtotal & Estimated Final Total
        const subtotalVal = document.getElementById('LaveeCartSubtotalVal');
        const totalVal = document.getElementById('LaveeCartTotalVal');
        const finalEstimatedTotalCents = Math.max(0, totalCents - appliedDiscountCents + shippingCostCents);

        if (subtotalVal) subtotalVal.textContent = this.formatMoney(totalCents);
        if (totalVal) totalVal.textContent = this.formatMoney(finalEstimatedTotalCents);

        // Update Checkout form parameters to pass discount code directly to Shopify Checkout
        const checkoutForm = document.querySelector('.lavee-cart-checkout-form');
        if (checkoutForm && couponCode) {
          let discountInput = checkoutForm.querySelector('input[name="discount"]');
          if (!discountInput) {
            discountInput = document.createElement('input');
            discountInput.type = 'hidden';
            discountInput.name = 'discount';
            checkoutForm.appendChild(discountInput);
          }
          discountInput.value = couponCode;
        }

        // 3. Progress Bar & Milestones (Dynamically configured 2, 3, 4, or 5 thresholds)
        const totalCents = cart.total_price;
        const thresholds = (window.themeCartSettings && window.themeCartSettings.thresholds) || [];
        
        const fill = document.getElementById('LaveeCartProgressFill');
        const progressText = document.getElementById('LaveeCartProgressText');
        const milestoneContainer = document.getElementById('LaveeCartMilestones');

        if (thresholds.length > 0) {
          // Ensure thresholds are sorted by amount ascending
          thresholds.sort(function(a, b) { return a.amount - b.amount; });

          const maxThreshold = thresholds[thresholds.length - 1].cents;
          let pct = Math.min(100, Math.round((totalCents / maxThreshold) * 100));
          if (fill) fill.style.width = pct + '%';

          let unlockedCount = 0;
          let nextTarget = null;

          for (let i = 0; i < thresholds.length; i++) {
            if (totalCents >= thresholds[i].cents) {
              unlockedCount++;
            } else {
              if (!nextTarget) nextTarget = thresholds[i];
            }
          }

          if (progressText) {
            if (unlockedCount === thresholds.length) {
              progressText.textContent = '🎉 ALL ATELIER GIFTS & FREE SHIPPING UNLOCKED!';
            } else if (unlockedCount > 0) {
              const currentReward = thresholds[unlockedCount - 1].title;
              const rem = nextTarget.cents - totalCents;
              progressText.textContent = '🎉 ' + currentReward.toUpperCase() + ' UNLOCKED! ADD ' + this.formatMoney(rem) + ' FOR ' + nextTarget.title.toUpperCase();
            } else {
              const rem = nextTarget.cents - totalCents;
              progressText.textContent = 'ADD ' + this.formatMoney(rem) + ' FOR ' + nextTarget.title.toUpperCase();
            }
          }

          if (milestoneContainer) {
            let milestonesHtml = '';
            thresholds.forEach(function(t) {
              const isUnlocked = totalCents >= t.cents;
              const icon = isUnlocked ? '✓' : '🔒';
              const unlockedClass = isUnlocked ? 'is-unlocked' : '';
              milestonesHtml += `<span class="lavee-milestone ${unlockedClass}">${icon} $${t.amount} (${t.title})</span>`;
            });
            milestoneContainer.innerHTML = milestonesHtml;
          }
        }

        // 4. Render Cart Line Items Stack
        const itemsStack = document.getElementById('LaveeCartItemsStack');
        if (itemsStack && cart.items) {
          if (cart.items.length === 0) {
            itemsStack.innerHTML = `
              <div class="lavee-cart-drawer-empty-state">
                <div class="lavee-cart-drawer-empty-icon">👜</div>
                <h3 class="lavee-cart-drawer-empty-title">YOUR ATELIER BAG IS EMPTY</h3>
                <p class="lavee-cart-drawer-empty-desc">Discover our newest couture silhouettes, corsets, and eveningwear edits.</p>
                <a href="${(window.routes && window.routes.all_products_collection_url) ? window.routes.all_products_collection_url : '/collections/all'}" class="lavee-cart-drawer-shop-btn">EXPLORE ATELIER COLLECTION →</a>
              </div>
            `;
          } else {
            let html = '';
            cart.items.forEach(item => {
              const itemTotal = this.formatMoney(item.final_line_price || item.line_price);
              const optionsStr = (item.options_with_values && item.options_with_values.length > 0)
                ? item.options_with_values.map(o => o.name + ': ' + o.value).join(' | ')
                : (item.variant_title && item.variant_title !== 'Default Title' ? item.variant_title : '');
              
              const imgUrl = item.featured_image?.url || item.image || '';

              html += `
                <div class="lavee-cart-item" data-line-key="${item.key}">
                  <div class="lavee-cart-item__left">
                    <a href="${item.url}" class="lavee-cart-item__thumb-link">
                      ${imgUrl ? `<img src="${imgUrl}" alt="${item.product_title || item.title}" width="55" height="72" class="lavee-cart-item__thumb">` : `<div class="lavee-cart-item__thumb-fallback"></div>`}
                    </a>
                    <div class="lavee-cart-item__details">
                      <a href="${item.url}" class="lavee-cart-item__title">${item.product_title || item.title}</a>
                      ${optionsStr ? `<div class="lavee-cart-item__options">${optionsStr}</div>` : ''}
                      <div class="lavee-cart-item__qty-box">
                        <button type="button" class="lavee-cart-item__qty-btn" data-action="cart-minus" data-line-key="${item.key}" data-qty="${item.quantity}">-</button>
                        <span class="lavee-cart-item__qty-num">${item.quantity}</span>
                        <button type="button" class="lavee-cart-item__qty-btn" data-action="cart-plus" data-line-key="${item.key}" data-qty="${item.quantity}">+</button>
                      </div>
                    </div>
                  </div>
                  <div class="lavee-cart-item__right">
                    <button type="button" class="lavee-cart-item__remove-btn" data-action="cart-remove" data-line-key="${item.key}" aria-label="Remove item">
                      <svg class="lavee-remove-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                    </button>
                    <div class="lavee-cart-item__price">${itemTotal}</div>
                  </div>
                </div>
              `;
            });
            itemsStack.innerHTML = html;
          }
        }
      },

      bindEvents: function() {
        const self = this;

        // Listen for PubSub cart updates from other elements (like standard product forms)
        if (typeof subscribe !== 'undefined' && typeof PUB_SUB_EVENTS !== 'undefined') {
          subscribe(PUB_SUB_EVENTS.cartUpdate, function(event) {
            if (!event || event.source !== 'lavee-internal') {
              self.refreshCartAndOpen();
            }
          });
        }

        document.addEventListener('click', function(e) {
          // 1. Size Pill Selection on Product Cards
          const sizePill = e.target.closest('.lavee-card__size-pill');
          if (sizePill) {
            e.preventDefault();
            const card = sizePill.closest('.lavee-card');
            if (card) {
              const allPills = card.querySelectorAll('.lavee-card__size-pill');
              allPills.forEach(p => p.classList.remove('is-selected'));
              sizePill.classList.add('is-selected');

              const variantId = sizePill.getAttribute('data-variant-id');
              if (variantId) {
                card.setAttribute('data-variant-id', variantId);
                const cartBtn = card.querySelector('.lavee-card__cta-btn--cart');
                if (cartBtn) cartBtn.setAttribute('data-variant-id', variantId);
              }
            }
            return;
          }

          // 2. Open Drawer trigger (Header cart icon / BAG link)
          if (
            e.target.closest('#cart-icon-bubble') || 
            e.target.closest('[data-action="open-cart-drawer"]') || 
            e.target.closest('.lavee-header__action-link--bag') || 
            e.target.closest('.header__icon--cart')
          ) {
            if (self.cartType === 'page') {
              return; // Allow standard navigation to /cart page if admin setting is explicitly set to 'page'
            }
            e.preventDefault();
            self.refreshCartAndOpen();
            return;
          }

          // 3. Close Drawer trigger
          if (e.target.closest('[data-action="close-cart-drawer"]')) {
            e.preventDefault();
            self.closeDrawer();
            return;
          }

          // 4. Product Card Add to Cart Button
          const cartBtn = e.target.closest('.lavee-card__cta-btn--cart, .lavee-card__cta-btn--quick, [data-action="add-to-cart"]');
          if (cartBtn) {
            e.preventDefault();
            const card = cartBtn.closest('.lavee-card') || cartBtn.closest('[data-product-id]');
            let variantId = cartBtn.getAttribute('data-variant-id');
            
            if (!variantId && card) {
              const selectedPill = card.querySelector('.lavee-card__size-pill.is-selected');
              if (selectedPill) {
                variantId = selectedPill.getAttribute('data-variant-id');
              } else {
                variantId = card.getAttribute('data-variant-id');
              }
            }

            if (variantId && variantId !== 'undefined' && !variantId.startsWith('4000000000')) {
              self.addItem(variantId, 1, cartBtn);
            } else if (variantId && variantId.startsWith('4000000000')) {
              // Onboarding placeholder demo feedback
              btnElement = cartBtn;
              btnElement.innerHTML = '<span>ADDED ✓</span>';
              setTimeout(() => { btnElement.innerHTML = '<span>ADD TO BAG</span>'; }, 1200);
              self.openDrawer();
            } else {
              if (card) card.classList.add('is-size-active');
            }
            return;
          }

          // 5. In-Cart Upsell Add Button
          const upsellBtn = e.target.closest('[data-action="quick-upsell-add"]');
          if (upsellBtn) {
            e.preventDefault();
            const vId = upsellBtn.getAttribute('data-variant-id');
            if (vId && !vId.startsWith('400000000')) self.addItem(vId, 1, upsellBtn);
            else {
              upsellBtn.innerHTML = 'ADDED ✓';
              setTimeout(() => { upsellBtn.innerHTML = '+ 1-CLICK ADD'; }, 1200);
            }
            return;
          }

          // 6. Quantity Stepper minus/plus & Remove buttons in Drawer
          const minusBtn = e.target.closest('[data-action="cart-minus"]');
          if (minusBtn) {
            const lKey = minusBtn.getAttribute('data-line-key');
            const currentQty = parseInt(minusBtn.getAttribute('data-qty') || '1', 10);
            self.updateItemQty(lKey, Math.max(0, currentQty - 1));
            return;
          }

          const plusBtn = e.target.closest('[data-action="cart-plus"]');
          if (plusBtn) {
            const lKey = plusBtn.getAttribute('data-line-key');
            const currentQty = parseInt(plusBtn.getAttribute('data-qty') || '1', 10);
            self.updateItemQty(lKey, currentQty + 1);
            return;
          }

          const removeBtn = e.target.closest('[data-action="cart-remove"]');
          if (removeBtn) {
            const lKey = removeBtn.getAttribute('data-line-key');
            self.updateItemQty(lKey, 0);
            return;
          }

          // 7. Upsell Container Collapse Toggle & Slider Nav
          const upsellHeader = e.target.closest('#LaveeCartUpsellToggleHeader');
          if (upsellHeader && !e.target.closest('.lavee-cart-upsell-slider-nav')) {
            e.preventDefault();
            const container = document.getElementById('LaveeCartUpsellContainer');
            const icon = document.getElementById('LaveeCartUpsellToggleIcon');
            if (container) {
              container.classList.toggle('is-collapsed');
              if (icon) icon.textContent = container.classList.contains('is-collapsed') ? '▼' : '▲';
            }
            return;
          }

          const upsellPrev = e.target.closest('#LaveeUpsellNavPrev');
          if (upsellPrev) {
            e.preventDefault();
            const cards = document.getElementById('LaveeCartUpsellCards');
            if (cards) cards.scrollBy({ left: -160, behavior: 'smooth' });
            return;
          }

          const upsellNext = e.target.closest('#LaveeUpsellNavNext');
          if (upsellNext) {
            e.preventDefault();
            const cards = document.getElementById('LaveeCartUpsellCards');
            if (cards) cards.scrollBy({ left: 160, behavior: 'smooth' });
            return;
          }

          // 8. Gift packaging toggle click
          const giftBtn = e.target.closest('#LaveeGiftToggleBtn');
          if (giftBtn) {
            e.preventDefault();
            self.toggleGiftPackaging(giftBtn);
            return;
          }

          // 9. Quick action buttons click (Coupon, Trust, Shipping)
          const actionBtn = e.target.closest('.lavee-cart-action-btn');
          if (actionBtn) {
            e.preventDefault();
            const popoverType = actionBtn.getAttribute('data-popover');
            if (popoverType) self.openPopover(popoverType);
            return;
          }

          // 10. Popover close click
          if (e.target.closest('#LaveeCartPopoverClose')) {
            e.preventDefault();
            self.closePopover();
            return;
          }
        });

        document.addEventListener('keydown', function(e) {
          if (e.key === 'Escape') {
            self.closePopover();
            self.closeDrawer();
          }
        });
      }
    };

    // Define CartDrawer custom element so product-form.js recognizes it
    class CartDrawerElement extends HTMLElement {
      constructor() {
        super();
      }
      getSectionsToRender() {
        return [
          { id: 'cart-drawer', section: 'cart-drawer', selector: '#LaveeCartDrawerWrapper' },
          { id: 'cart-icon-bubble', section: 'cart-icon-bubble', selector: '#cart-icon-bubble' }
        ];
      }
      setActiveElement(element) {
        this.activeElement = element;
      }
      renderContents(parsedState) {
        if (window.LaveeCartController) {
          window.LaveeCartController.refreshCartAndOpen();
        }
      }
      open(triggeredBy) {
        if (window.LaveeCartController) {
          window.LaveeCartController.openDrawer();
        }
      }
      close() {
        if (window.LaveeCartController) {
          window.LaveeCartController.closeDrawer();
        }
      }
    }

    if (!customElements.get('cart-drawer')) {
      customElements.define('cart-drawer', CartDrawerElement);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function() { window.LaveeCartController.init(); });
    } else {
      window.LaveeCartController.init();
    }
  })();
</script>

